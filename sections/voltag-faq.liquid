{%- comment -%} VOLTAG — FAQ | sections/voltag-faq.liquid {%- endcomment -%}

<style>
#vf-{{ section.id }}{--y:#FFD60A;--g:#39FF14;--b:#00A3FF;--r:#FF2D55;--cy:{{ section.settings.neon }};
  background:{{ section.settings.bg }};color:#fff;padding:40px 0 56px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif}
#vf-{{ section.id }} *{box-sizing:border-box}
#vf-{{ section.id }} p,#vf-{{ section.id }} h2,#vf-{{ section.id }} h3{margin:0}
#vf-{{ section.id }} .f-in{max-width:760px;margin:0 auto;padding:0 20px}
#vf-{{ section.id }} .f-head{text-align:center;margin-bottom:4px}
#vf-{{ section.id }} .f-eye{font-size:13px;font-weight:800;letter-spacing:.16em;color:var(--cy);
  text-shadow:0 0 10px color-mix(in srgb,var(--cy) 50%,transparent)}
#vf-{{ section.id }} .f-sub{margin-top:8px;font-size:14px;color:#8f9ab3}
#vf-{{ section.id }} .f-list{display:flex;flex-direction:column;gap:10px;margin-top:24px}

#vf-{{ section.id }} .f-q{border-radius:14px;border:1px solid #1c2335;background:#0d1424;transition:border-color .3s,box-shadow .3s}
#vf-{{ section.id }} .f-q[open]{border-color:color-mix(in srgb,var(--cy) 45%,transparent);
  box-shadow:0 0 18px color-mix(in srgb,var(--cy) 8%,transparent)}
#vf-{{ section.id }} .f-q summary{list-style:none;display:flex;align-items:center;gap:14px;padding:13px 14px;cursor:pointer;
  -webkit-tap-highlight-color:transparent}
#vf-{{ section.id }} .f-q summary::-webkit-details-marker{display:none}
#vf-{{ section.id }} .f-ico{flex:none;display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:#16203a}
#vf-{{ section.id }} .f-ico svg{width:16px;height:16px;fill:none;stroke:var(--cy);stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
#vf-{{ section.id }} .f-qt{flex:1;font-size:14.5px;font-weight:700;color:#fff;line-height:1.35}
#vf-{{ section.id }} .f-x{flex:none;position:relative;width:24px;height:24px;border-radius:50%;background:#16203a;
  transition:transform .3s ease,background .3s}
#vf-{{ section.id }} .f-x::before,#vf-{{ section.id }} .f-x::after{content:"";position:absolute;left:50%;top:50%;
  width:9px;height:1.6px;margin:-.8px 0 0 -4.5px;border-radius:2px;background:var(--cy)}
#vf-{{ section.id }} .f-x::after{transform:rotate(90deg)}
#vf-{{ section.id }} .f-q[open] .f-x{transform:rotate(45deg);background:#1a2a44}
#vf-{{ section.id }} .f-a{overflow:hidden}
#vf-{{ section.id }} .f-a>div{padding:2px 18px 18px 60px;display:flex;flex-direction:column;gap:12px}
#vf-{{ section.id }} .f-a p{font-size:14.5px;line-height:1.6;color:#a9b2c7}
#vf-{{ section.id }} .f-a strong{color:#fff;font-weight:700}
#vf-{{ section.id }} .f-a a{color:var(--cy);text-decoration:underline;text-underline-offset:2px}
#vf-{{ section.id }} .f-teams{display:inline-flex;gap:3px;margin:0 2px;vertical-align:1px}
#vf-{{ section.id }} .f-teams i{width:8px;height:8px;border-radius:50%;background:var(--c);box-shadow:0 0 6px var(--c)}
#vf-{{ section.id }} .f-modes{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}
#vf-{{ section.id }} .f-modes span{padding:7px 4px;border-radius:9px;background:#0b1120;border:1px solid #1f2b47;
  font-size:12px;font-weight:800;letter-spacing:.06em;color:#fff;text-align:center}
#vf-{{ section.id }} .f-foot{margin-top:24px;font-size:14px;color:#8f9ab3;text-align:center}
#vf-{{ section.id }} .f-foot a{color:var(--cy);font-weight:700}

@media (max-width:749px){
  #vf-{{ section.id }}{padding:28px 0 44px}
  #vf-{{ section.id }} .f-in{padding:0 16px}
  #vf-{{ section.id }} .f-q summary{padding:12px;gap:12px}
  #vf-{{ section.id }} .f-ico{width:30px;height:30px}
  #vf-{{ section.id }} .f-qt{font-size:14px}
  #vf-{{ section.id }} .f-a>div{padding:2px 14px 16px 54px}
  #vf-{{ section.id }} .f-a p{font-size:14px}
  #vf-{{ section.id }} .f-modes{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media (prefers-reduced-motion:reduce){
  #vf-{{ section.id }} *,#vf-{{ section.id }} *::before{animation:none !important;transition:none !important}
}
</style>

<section id="vf-{{ section.id }}">
  <div class="f-in">
    <div class="f-head">
      <h2 class="f-eye">{{ section.settings.heading }}</h2>
      {%- if section.settings.sub != blank -%}<p class="f-sub">{{ section.settings.sub }}</p>{%- endif -%}
    </div>

    <div class="f-list">
      {%- for block in section.blocks -%}
        <details class="f-q" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>
            <span class="f-ico" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'check' -%}
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.8 2.8L16.5 9"/></svg>
                {%- when 'heart' -%}
                  <svg viewBox="0 0 24 24"><path d="M12 21s-7-4.4-9.2-9C1.3 8.8 3.4 5 7 5c2 0 3.4 1.1 5 3 1.6-1.9 3-3 5-3 3.6 0 5.7 3.8 4.2 7-2.2 4.6-9.2 9-9.2 9z"/></svg>
                {%- when 'target' -%}
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="2.5"/><path d="M12 1v4M12 19v4M1 12h4M19 12h4"/></svg>
                {%- when 'bolt' -%}
                  <svg viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>
                {%- when 'globe' -%}
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3"/></svg>
                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24"><path d="M2 7h11v9H2zM13 10h4l4 3v3h-8z"/><circle cx="6.5" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24"><path d="M4 5h16v12H8l-4 4z"/></svg>
              {%- endcase -%}
            </span>
            <h3 class="f-qt">{{ block.settings.question }}</h3>
            <span class="f-x" aria-hidden="true"></span>
          </summary>
          <div class="f-a">
            <div>
              {{ block.settings.answer }}
              {%- if block.settings.show_teams -%}
                <p>Les quatre couleurs d'équipe
                  <span class="f-teams">
                    <i style="--c:var(--y)"></i><i style="--c:var(--g)"></i><i style="--c:var(--b)"></i><i style="--c:var(--r)"></i>
                  </span>
                </p>
              {%- endif -%}
              {%- if block.settings.show_modes -%}
                <div class="f-modes">
                  <span>{{ section.settings.mode_1 }}</span>
                  <span>{{ section.settings.mode_2 }}</span>
                  <span>{{ section.settings.mode_3 }}</span>
                  <span>{{ section.settings.mode_4 }}</span>
                </div>
              {%- endif -%}
            </div>
          </div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.foot != blank -%}
      <div class="f-foot">{{ section.settings.foot }}</div>
    {%- endif -%}
  </div>
</section>

{%- capture faq_json -%}
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | strip_html | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | strip_newlines | json }} }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
{%- endcapture -%}
<script type="application/ld+json">{{ faq_json }}</script>

{% schema %}
{
  "name": "VOLTAG — FAQ",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg", "label": "Fond", "default": "#05060A" },
    { "type": "color", "id": "neon", "label": "Accent", "default": "#00E5FF" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "QUESTIONS SUR CE PRODUIT" },
    { "type": "text", "id": "sub", "label": "Sous-titre", "default": "Tout ce qu'il faut savoir avant de commander votre pack VOLTAG" },
    { "type": "checkbox", "id": "open_first", "label": "Ouvrir la première question", "default": true },
    { "type": "richtext", "id": "foot", "label": "Note de bas de section",
      "default": "<p>Une autre question ? Écrivez-nous, nous répondons sous 24 heures ouvrées.</p>" },

    { "type": "header", "content": "Noms des modes de tir" },
    { "type": "text", "id": "mode_1", "label": "Mode 1", "default": "PISTOLET" },
    { "type": "text", "id": "mode_2", "label": "Mode 2", "default": "MITRAILLETTE" },
    { "type": "text", "id": "mode_3", "label": "Mode 3", "default": "PRÉCISION" },
    { "type": "text", "id": "mode_4", "label": "Mode 4", "default": "ROQUETTE" }
  ],
  "blocks": [
    { "type": "qa", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Votre question" },
      { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Votre réponse.</p>" },
      { "type": "select", "id": "icon", "label": "Icône",
        "options": [
          { "value": "box", "label": "Boîte" },
          { "value": "check", "label": "Coche" },
          { "value": "heart", "label": "Cœur" },
          { "value": "target", "label": "Cible" },
          { "value": "bolt", "label": "Éclair" },
          { "value": "globe", "label": "Globe" },
          { "value": "truck", "label": "Camion" }
        ], "default": "box" },
      { "type": "checkbox", "id": "show_teams", "label": "Afficher les pastilles d'équipe", "default": false },
      { "type": "checkbox", "id": "show_modes", "label": "Afficher les quatre modes de tir", "default": false }
    ]}
  ],
  "presets": [
    { "name": "VOLTAG — FAQ", "blocks": [
      { "type": "qa", "settings": { "icon": "box", "show_teams": true,
        "question": "Que contient la boîte ?",
        "answer": "<p>Chaque pack contient autant de blasters infrarouges que de cibles de poitrine à LED.</p><p><strong>Duo :</strong> 2 blasters et 2 cibles, pour un duel. <strong>Squad :</strong> 4 blasters et 4 cibles dans les quatre couleurs. <strong>Arène :</strong> 8 blasters et 8 cibles.</p><p>Les piles ne sont pas fournies.</p>" } },
      { "type": "qa", "settings": { "icon": "check",
        "question": "Comment se déroule une partie ?",
        "answer": "<p>Chacun choisit sa couleur, enfile sa cible de poitrine et la partie démarre. Vous visez la cible des autres joueurs pour marquer. À chaque impact, la cible s'allume, l'afficheur décompte les vies restantes, et le son et la vibration rendent la touche indiscutable.</p>" } },
      { "type": "qa", "settings": { "icon": "heart",
        "question": "Est-ce sans danger pour les enfants ?",
        "answer": "<p>Oui. VOLTAG fonctionne par <strong>signaux infrarouges</strong>, comme une télécommande de télévision : aucun faisceau laser, aucun projectile, donc rien qui puisse blesser ou se perdre. Le fabricant indique le jeu à partir de <strong>8 ans</strong>, et les sangles réglables s'adaptent aussi bien aux enfants qu'aux adultes.</p>" } },
      { "type": "qa", "settings": { "icon": "target", "show_modes": true,
        "question": "Peut-on changer de mode de tir ?",
        "answer": "<p>Oui. Chaque blaster passe d'un mode à l'autre entre <strong>quatre modes de tir</strong>, chacun avec ses munitions et sa puissance, ce qui permet de changer de tactique en pleine partie.</p>" } },
      { "type": "qa", "settings": { "icon": "bolt",
        "question": "Faut-il des piles ?",
        "answer": "<p>Oui, et <strong>elles ne sont pas fournies</strong>. Les blasters comme les cibles fonctionnent avec des piles AAA. Aucune recharge n'est nécessaire : vous les insérez et vous jouez.</p>" } },
      { "type": "qa", "settings": { "icon": "globe",
        "question": "Peut-on jouer en intérieur et en extérieur ?",
        "answer": "<p>Les deux. Le salon, le sous-sol, le jardin ou un parc conviennent très bien. En extérieur, la portée annoncée par le fabricant va jusqu'à <strong>40 à 60 mètres</strong> selon le mode, de quoi s'éparpiller et jouer à cache-cache.</p>" } },
      { "type": "qa", "settings": { "icon": "truck",
        "question": "Livraison et retours",
        "answer": "<p>Chaque commande part avec un numéro de suivi. Vous disposez de <strong>30 jours</strong> à compter de la réception pour changer d'avis, soit plus que les 14 jours du droit de rétractation légal. Contactez-nous et nous organisons le retour ou l'échange.</p>" } }
    ]}
  ]
}
{% endschema %}
