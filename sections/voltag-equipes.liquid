{%- comment -%} VOLTAG — Équipes | sections/voltag-equipes.liquid {%- endcomment -%}

<style>
#vte-{{ section.id }}{background:{{ section.settings.bg }};color:#fff;padding:56px 0 48px;overflow:hidden;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif}
#vte-{{ section.id }} *{box-sizing:border-box}
#vte-{{ section.id }} .vte__inner{max-width:1000px;margin:0 auto;padding:0 20px;display:flex;flex-direction:column;align-items:center}
#vte-{{ section.id }} .vte__heading{margin:0;text-align:center;color:#fff;font-weight:800;letter-spacing:-.02em;line-height:1.1;font-size:clamp(26px,4.2vw,44px);text-wrap:balance}
#vte-{{ section.id }} .vte__laser{display:block;width:min(260px,60%);height:3px;margin:16px auto 32px;border-radius:3px;
  background:linear-gradient(90deg,transparent,#FF2D55,#FFD60A,#39FF14,#00A3FF,{{ section.settings.neon }},transparent);
  background-size:200% 100%;animation:vte-flow-{{ section.id }} 3s linear infinite;box-shadow:0 0 12px color-mix(in srgb,{{ section.settings.neon }} 60%,transparent)}
#vte-{{ section.id }} .vte__grid{display:grid;grid-template-columns:repeat({{ section.blocks.size | at_most: 4 | at_least: 1 }},minmax(0,1fr));gap:18px;width:100%}
#vte-{{ section.id }} .vte__tile{position:relative;border-radius:18px;padding:2px;overflow:hidden;isolation:isolate;background:#1a2438;
  box-shadow:0 0 22px color-mix(in srgb,var(--c) 30%,transparent);transition:transform .3s ease,box-shadow .3s ease}
#vte-{{ section.id }} .vte__tile::before{content:"";position:absolute;inset:-60%;z-index:-1;
  background:conic-gradient(from 0deg,transparent 0 60%,var(--c) 78%,#fff 80%,var(--c) 82%,transparent 95%);
  animation:vte-spin-{{ section.id }} 5s linear infinite}
#vte-{{ section.id }} .vte__tile:nth-child(2)::before{animation-delay:-1.6s}
#vte-{{ section.id }} .vte__tile:nth-child(3)::before{animation-delay:-3.2s}
#vte-{{ section.id }} .vte__tile:nth-child(4)::before{animation-delay:-4.8s}
#vte-{{ section.id }} .vte__tile:hover{transform:translateY(-4px);box-shadow:0 0 34px color-mix(in srgb,var(--c) 55%,transparent)}
#vte-{{ section.id }} .vte__frame{position:relative;border-radius:16px;overflow:hidden;background:#05080f;aspect-ratio:9/16;max-width:100%}
#vte-{{ section.id }} .vte__media,
#vte-{{ section.id }} .vte__frame video,
#vte-{{ section.id }} .vte__frame img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;background:#05080f}
#vte-{{ section.id }} .vte__empty{position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:22px;
  color:#5d708a;font-size:12px;line-height:1.6;letter-spacing:.04em}
#vte-{{ section.id }} .vte__scan{position:absolute;left:0;right:0;top:-10%;height:12%;pointer-events:none;z-index:2;
  background:linear-gradient(180deg,transparent,color-mix(in srgb,var(--c) 22%,transparent) 45%,color-mix(in srgb,var(--c) 70%,#fff) 50%,color-mix(in srgb,var(--c) 22%,transparent) 55%,transparent);
  mix-blend-mode:screen;opacity:.55;animation:vte-scan-{{ section.id }} 4.5s ease-in-out infinite}
#vte-{{ section.id }} .vte__tile:nth-child(2) .vte__scan{animation-delay:-1.5s}
#vte-{{ section.id }} .vte__tile:nth-child(3) .vte__scan{animation-delay:-3s}
#vte-{{ section.id }} .vte__tile:nth-child(4) .vte__scan{animation-delay:-4.5s}
#vte-{{ section.id }} .vte__corner{position:absolute;width:18px;height:18px;border:2px solid var(--c);filter:drop-shadow(0 0 4px var(--c));pointer-events:none;z-index:3}
#vte-{{ section.id }} .vte__corner--tl{top:10px;left:10px;border-right:0;border-bottom:0;border-top-left-radius:6px}
#vte-{{ section.id }} .vte__corner--tr{top:10px;right:10px;border-left:0;border-bottom:0;border-top-right-radius:6px}
#vte-{{ section.id }} .vte__corner--bl{bottom:10px;left:10px;border-right:0;border-top:0;border-bottom-left-radius:6px}
#vte-{{ section.id }} .vte__corner--br{bottom:10px;right:10px;border-left:0;border-top:0;border-bottom-right-radius:6px}
#vte-{{ section.id }} .vte__badge{position:absolute;left:50%;bottom:16px;transform:translateX(-50%);display:inline-flex;align-items:center;gap:7px;z-index:3;
  padding:6px 12px;border-radius:999px;font-size:11px;font-weight:800;letter-spacing:.12em;color:#fff;white-space:nowrap;
  background:rgba(5,8,15,.72);border:1px solid color-mix(in srgb,var(--c) 60%,transparent);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
  box-shadow:0 0 12px color-mix(in srgb,var(--c) 40%,transparent)}
#vte-{{ section.id }} .vte__badge i{width:7px;height:7px;border-radius:50%;background:var(--c);box-shadow:0 0 8px var(--c);animation:vte-blink-{{ section.id }} 1.4s ease-in-out infinite}
#vte-{{ section.id }} .vte__tagline{margin:32px 0 0;display:inline-flex;align-items:center;gap:10px;padding:10px 18px;border-radius:999px;
  background:#0f1626;border:1px solid #1E3A4C;box-shadow:0 0 18px color-mix(in srgb,{{ section.settings.neon }} 25%,transparent);color:#fff;font-weight:700;font-size:15px;text-align:center}
#vte-{{ section.id }} .vte__tagline svg{width:18px;height:18px;fill:{{ section.settings.neon }};filter:drop-shadow(0 0 6px {{ section.settings.neon }});flex:none}
#vte-{{ section.id }} .vte__disclaimer{margin:14px auto 0;max-width:720px;text-align:center;color:#8f9ab3;font-size:12px;line-height:1.55}
@keyframes vte-spin-{{ section.id }}{to{transform:rotate(360deg)}}
@keyframes vte-scan-{{ section.id }}{0%{top:-12%}60%,100%{top:105%}}
@keyframes vte-flow-{{ section.id }}{to{background-position:200% 0}}
@keyframes vte-blink-{{ section.id }}{0%,100%{opacity:1}50%{opacity:.25}}
@media (max-width:749px){
  #vte-{{ section.id }}{padding:40px 0 36px}
  #vte-{{ section.id }} .vte__inner{padding:0}
  #vte-{{ section.id }} .vte__heading{padding:0 16px}
  #vte-{{ section.id }} .vte__laser{margin:12px auto 22px}
  #vte-{{ section.id }} .vte__grid{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding:16px 16px 18px;scroll-padding:0 16px;-webkit-overflow-scrolling:touch;scrollbar-width:none}
  #vte-{{ section.id }} .vte__grid::-webkit-scrollbar{display:none}
  #vte-{{ section.id }} .vte__tile{flex:0 0 68%;scroll-snap-align:start}
  #vte-{{ section.id }} .vte__tile:hover{transform:none}
  #vte-{{ section.id }} .vte__tagline{margin:22px 16px 0;font-size:14px}
  #vte-{{ section.id }} .vte__disclaimer{padding:0 16px;font-size:11px}
}
@media (prefers-reduced-motion:reduce){
  #vte-{{ section.id }} .vte__tile::before,
  #vte-{{ section.id }} .vte__scan,
  #vte-{{ section.id }} .vte__laser,
  #vte-{{ section.id }} .vte__badge i{animation:none}
  #vte-{{ section.id }} .vte__scan{display:none}
}
</style>

<section id="vte-{{ section.id }}">
  <div class="vte__inner">
    <h2 class="vte__heading">{{ section.settings.heading }}</h2>
    <span class="vte__laser" aria-hidden="true"></span>

    <div class="vte__grid">
      {%- for block in section.blocks -%}
        <div class="vte__tile" style="--c: {{ block.settings.color }}" {{ block.shopify_attributes }}>
          <div class="vte__frame">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: class: 'vte__media', autoplay: true, loop: true, muted: true, controls: false, image_size: '800x' }}
            {%- elsif block.settings.video_url != blank -%}
              <video class="vte__media" src="{{ block.settings.video_url }}" autoplay muted loop playsinline preload="metadata"></video>
            {%- elsif block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,900', alt: block.settings.label }}
            {%- else -%}
              <div class="vte__empty">Choisissez une vidéo ou une image<br>pour cette équipe</div>
            {%- endif -%}

            <span class="vte__scan" aria-hidden="true"></span>
            <span class="vte__corner vte__corner--tl" aria-hidden="true"></span>
            <span class="vte__corner vte__corner--tr" aria-hidden="true"></span>
            <span class="vte__corner vte__corner--bl" aria-hidden="true"></span>
            <span class="vte__corner vte__corner--br" aria-hidden="true"></span>
            <span class="vte__badge"><i></i>{{ block.settings.label }}</span>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.tagline != blank -%}
      <p class="vte__tagline">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z"></path></svg>
        <span>{{ section.settings.tagline }}</span>
      </p>
    {%- endif -%}

    {%- if section.settings.disclaimer != blank -%}
      <p class="vte__disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('vte-{{ section.id }}');
  if (!root) return;
  var vids = root.querySelectorAll('video');
  vids.forEach(function (v) { v.muted = true; v.setAttribute('playsinline', ''); });
  if (!('IntersectionObserver' in window)) return;
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      var v = e.target;
      if (e.isIntersecting) { var p = v.play(); if (p && p.catch) p.catch(function () {}); }
      else { v.pause(); }
    });
  }, { threshold: 0.25 });
  vids.forEach(function (v) { io.observe(v); });
})();
</script>

{% schema %}
{
  "name": "VOLTAG — Équipes",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg", "label": "Fond", "default": "#05060A" },
    { "type": "color", "id": "neon", "label": "Accent", "default": "#00E5FF" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Choisis ton camp. Équipe-toi. Allume l'arène." },
    { "type": "text", "id": "tagline", "label": "Signature", "default": "Vrai infrarouge. Vraies parties." },
    { "type": "textarea", "id": "disclaimer", "label": "Mention légale",
      "info": "Important : précisez que le produit n'émet aucun faisceau visible.",
      "default": "VOLTAG détecte les impacts par signaux infrarouges, et non par faisceau laser. Les traits lumineux visibles dans ces vidéos sont un effet visuel ajouté : le produit n'émet aucun rayon." }
  ],
  "blocks": [
    { "type": "team", "name": "Équipe", "limit": 4, "settings": [
      { "type": "text", "id": "label", "label": "Nom de l'équipe", "default": "ÉQUIPE BLEUE" },
      { "type": "color", "id": "color", "label": "Couleur", "default": "#00A3FF" },
      { "type": "video", "id": "video", "label": "Vidéo",
        "info": "Format vertical 9:16. Envoyez-la d'abord dans Contenu → Fichiers." },
      { "type": "text", "id": "video_url", "label": "ou URL de vidéo",
        "info": "Lien direct .mp4, si vous préférez à la sélection ci-dessus." },
      { "type": "image_picker", "id": "image", "label": "ou Image de repli" }
    ]}
  ],
  "presets": [
    { "name": "VOLTAG — Équipes", "blocks": [
      { "type": "team", "settings": { "label": "ÉQUIPE BLEUE", "color": "#00A3FF" } },
      { "type": "team", "settings": { "label": "ÉQUIPE ROUGE", "color": "#FF2D55" } },
      { "type": "team", "settings": { "label": "ÉQUIPE VERTE", "color": "#39FF14" } }
    ]}
  ]
}
{% endschema %}
