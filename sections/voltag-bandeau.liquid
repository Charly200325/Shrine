{%- liquid
  assign acc = section.settings.accent
  assign red = section.settings.live_color
-%}

<style>
#vb-{{ section.id }}{--a:{{ acc }};--red:{{ red }};color:#fff;background:{{ section.settings.bg }}}
#vb-{{ section.id }} *{box-sizing:border-box}
#vb-{{ section.id }} p{margin:0}

/* ---------- bandeau défilant ---------- */
#vb-{{ section.id }} .vb-ticker{position:relative;overflow:hidden;padding:11px 0;
  background:{{ section.settings.ticker_bg }};border-bottom:1px solid {{ section.settings.rule }}}
#vb-{{ section.id }} .vb-track{display:flex;width:max-content;
  animation:vb-move-{{ section.id }} {{ section.settings.speed }}s linear infinite}
#vb-{{ section.id }} .vb-ticker:hover .vb-track{animation-play-state:paused}
#vb-{{ section.id }} .vb-list{display:flex;align-items:center;flex:none}
#vb-{{ section.id }} .vb-it{display:inline-flex;align-items:center;gap:34px;padding-right:34px;
  font-size:13px;font-weight:800;letter-spacing:.04em;color:#f1f3f7;white-space:nowrap}
#vb-{{ section.id }} .vb-it svg{width:13px;height:13px;fill:none;stroke:var(--a);stroke-width:2.2}
#vb-{{ section.id }} .vb-it svg .c{fill:var(--a);stroke:none}
@keyframes vb-move-{{ section.id }}{to{transform:translateX(-50%)}}

/* ---------- barre promo ---------- */
#vb-{{ section.id }} .vb-promo{position:relative;overflow:hidden;display:flex;align-items:center;
  justify-content:center;flex-wrap:wrap;gap:8px 14px;padding:13px 16px;background:{{ section.settings.promo_bg }};
  text-decoration:none;color:#fff;border-top:2px solid var(--a);border-bottom:2px solid var(--a)}
#vb-{{ section.id }} .vb-promo::before{content:"";position:absolute;top:0;bottom:0;left:-40%;width:40%;
  background:linear-gradient(100deg,transparent,{{ acc | color_modify: 'alpha', 0.28 }},transparent);
  animation:vb-shine-{{ section.id }} 2.8s ease-in-out infinite;pointer-events:none}
@keyframes vb-shine-{{ section.id }}{0%{left:-40%}60%,100%{left:110%}}
#vb-{{ section.id }} .vb-promo>*{position:relative;z-index:1}

#vb-{{ section.id }} .vb-live{display:inline-flex;align-items:center;gap:6px;padding:4px 9px;border-radius:999px;
  background:var(--red);font-size:11px;font-weight:900;letter-spacing:.1em;color:#fff;
  box-shadow:0 0 14px {{ red | color_modify: 'alpha', 0.55 }}}
#vb-{{ section.id }} .vb-live i{width:7px;height:7px;border-radius:50%;background:#fff;
  animation:vb-blink-{{ section.id }} 1s steps(1) infinite}
@keyframes vb-blink-{{ section.id }}{50%{opacity:.15}}

#vb-{{ section.id }} .vb-offer{display:inline-flex;align-items:center;gap:7px;font-size:15px;font-weight:900;
  letter-spacing:.02em;color:#fff}
#vb-{{ section.id }} .vb-offer b{font-weight:900;color:var(--a);
  text-shadow:0 0 14px {{ acc | color_modify: 'alpha', 0.55 }}}
#vb-{{ section.id }} .vb-tag{font-size:12.5px;font-weight:800;letter-spacing:.06em;color:#c9d1e4}
#vb-{{ section.id }} .vb-cta{display:inline-flex;align-items:center;padding:7px 14px;border-radius:999px;
  background:var(--a);color:#000;font-size:12px;font-weight:900;letter-spacing:.06em;white-space:nowrap;
  animation:vb-pulse-{{ section.id }} 1.6s ease-in-out infinite}
@keyframes vb-pulse-{{ section.id }}{
  0%,100%{transform:scale(1);box-shadow:0 0 0 0 {{ acc | color_modify: 'alpha', 0.6 }}}
  50%{transform:scale(1.06);box-shadow:0 0 0 7px {{ acc | color_modify: 'alpha', 0 }}}}

@media (max-width:749px){
  #vb-{{ section.id }} .vb-ticker{padding:8px 0}
  #vb-{{ section.id }} .vb-it{font-size:11px;gap:20px;padding-right:20px}
  #vb-{{ section.id }} .vb-it svg{width:10px;height:10px}
  #vb-{{ section.id }} .vb-track{animation-duration:{{ section.settings.speed | times: 0.7 | round }}s}
  #vb-{{ section.id }} .vb-promo{flex-wrap:nowrap;gap:8px;padding:10px}
  #vb-{{ section.id }} .vb-offer{font-size:12.5px;letter-spacing:0;white-space:nowrap;gap:4px}
  #vb-{{ section.id }} .vb-live{padding:3px 7px;font-size:9.5px;gap:4px}
  #vb-{{ section.id }} .vb-live i{width:6px;height:6px}
  #vb-{{ section.id }} .vb-tag,#vb-{{ section.id }} .vb-cta{display:none}
}
@media (max-width:379px){
  #vb-{{ section.id }} .vb-offer{font-size:11px}
  #vb-{{ section.id }} .vb-live{font-size:8.5px}
}
@media (prefers-reduced-motion:reduce){
  #vb-{{ section.id }} *,#vb-{{ section.id }} ::before{animation:none !important}
}
</style>

{%- capture vb_list -%}
  <div class="vb-list">
    {%- for block in section.blocks -%}
      {%- if block.type == 'item' and block.settings.text != blank -%}
        <span class="vb-it" {{ block.shopify_attributes }}>
          {{ block.settings.text }}
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <circle cx="8" cy="8" r="6"></circle>
            <circle class="c" cx="8" cy="8" r="1.8"></circle>
          </svg>
        </span>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endcapture -%}

<div id="vb-{{ section.id }}">

  {%- if section.blocks.size > 0 -%}
    <div class="vb-ticker" role="marquee" aria-label="{{ section.settings.ticker_label | escape }}">
      <div class="vb-track">
        {{ vb_list }}
        <div aria-hidden="true">{{ vb_list }}</div>
        <div aria-hidden="true">{{ vb_list }}</div>
        <div aria-hidden="true">{{ vb_list }}</div>
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.show_promo -%}
    <a class="vb-promo" href="{{ section.settings.promo_link | default: '/' }}">
      {%- if section.settings.live_label != blank -%}
        <span class="vb-live"><i></i>{{ section.settings.live_label }}</span>
      {%- endif -%}
      <span class="vb-offer">
        {{ section.settings.offer_text }}
        {%- if section.settings.offer_strong != blank %} <b>{{ section.settings.offer_strong }}</b>{% endif -%}
      </span>
      {%- if section.settings.promo_tag != blank -%}
        <span class="vb-tag">{{ section.settings.promo_tag }}</span>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <span class="vb-cta">{{ section.settings.cta_label }}</span>
      {%- endif -%}
    </a>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "VOLTAG — Bandeau",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#0d121b" },
    { "type": "color", "id": "ticker_bg", "label": "Fond du bandeau défilant", "default": "#0b0f17" },
    { "type": "color", "id": "rule", "label": "Filet", "default": "#1a2130" },
    { "type": "color", "id": "promo_bg", "label": "Fond de la barre promo", "default": "#000000" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#FCD34D" },
    { "type": "color", "id": "live_color", "label": "Pastille LIVE", "default": "#FF3B4E" },

    { "type": "header", "content": "Bandeau défilant" },
    { "type": "range", "id": "speed", "label": "Durée d'un cycle", "min": 15, "max": 60, "step": 1, "default": 34, "unit": "s" },
    { "type": "text", "id": "ticker_label", "label": "Libellé d'accessibilité", "default": "Nos garanties" },

    { "type": "header", "content": "Barre promo" },
    { "type": "checkbox", "id": "show_promo", "label": "Afficher la barre promo", "default": true },
    { "type": "url", "id": "promo_link", "label": "Lien" },
    { "type": "text", "id": "live_label", "label": "Pastille", "default": "LIVE" },
    { "type": "text", "id": "offer_text", "label": "Texte de l'offre", "default": "PRÉ-VENTE BLACK FRIDAY —" },
    { "type": "text", "id": "offer_strong", "label": "Partie mise en avant", "default": "ACCÈS ANTICIPÉ" },
    { "type": "paragraph", "content": "Si vous affichez un pourcentage de remise ici, il doit correspondre à une réduction réelle, calculée sur le prix le plus bas pratiqué dans les 30 jours précédents." },
    { "type": "text", "id": "promo_tag", "label": "Mention secondaire", "default": "DURÉE LIMITÉE · STOCK DÉDIÉ" },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "J'EN PROFITE →" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Mention",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "LIVRAISON SUIVIE" }
      ]
    }
  ],
  "presets": [
    {
      "name": "VOLTAG — Bandeau",
      "blocks": [
        { "type": "item", "settings": { "text": "LIVRAISON SUIVIE" } },
        { "type": "item", "settings": { "text": "PAIEMENT SÉCURISÉ" } },
        { "type": "item", "settings": { "text": "RETOURS SOUS 30 JOURS" } },
        { "type": "item", "settings": { "text": "SERVICE CLIENT EN FRANÇAIS" } }
      ]
    }
  ]
}
{% endschema %}
