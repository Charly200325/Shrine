{%- comment -%} VOLTAG — Avis | sections/voltag-avis.liquid {%- endcomment -%}

{%- liquid
  assign rating = product.metafields.reviews.rating.value
  assign rcount = product.metafields.reviews.rating_count.value | default: 0
  assign has_data = false
  if rating != blank and rcount > 0
    assign has_data = true
  endif
-%}

<style>
#va-{{ section.id }}{--cy:{{ section.settings.accent }};--star:{{ section.settings.star_color }};
  background:{{ section.settings.bg }};color:#fff;padding:56px 0 64px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif}
#va-{{ section.id }} *{box-sizing:border-box}
#va-{{ section.id }} p{margin:0}
#va-{{ section.id }} .r-in{max-width:1120px;margin:0 auto;padding:0 24px}

/* ---- en-tête ---- */
#va-{{ section.id }} .r-top{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;flex-wrap:wrap}
#va-{{ section.id }} h2{margin:0;font-size:clamp(24px,3.2vw,30px);font-weight:800;letter-spacing:-.01em}
#va-{{ section.id }} .r-score{display:flex;align-items:baseline;gap:10px;margin-top:10px}
#va-{{ section.id }} .r-big{font-size:30px;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}
#va-{{ section.id }} .r-cnt{font-size:14px;color:#8f9ab3}
#va-{{ section.id }} .r-acts{display:flex;align-items:center;gap:10px}
#va-{{ section.id }} .r-write{display:inline-flex;align-items:center;justify-content:center;padding:13px 26px;border-radius:10px;
  background:var(--star);color:#0b1120;font:inherit;font-size:15px;font-weight:800;text-decoration:none;border:0;cursor:pointer}
#va-{{ section.id }} .r-write:hover{filter:brightness(1.06)}
#va-{{ section.id }} .r-ico{display:grid;place-items:center;width:44px;height:44px;border-radius:10px;border:1px solid #2a3550;
  background:transparent;color:#fff;cursor:pointer}
#va-{{ section.id }} .r-ico svg{width:18px;height:18px;fill:none;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
#va-{{ section.id }} .r-ico:hover{border-color:var(--cy)}

/* ---- points forts ---- */
#va-{{ section.id }} .r-hl{margin-top:26px}
#va-{{ section.id }} .r-hl-t{font-size:15px;font-weight:800;margin-bottom:12px}
#va-{{ section.id }} .r-hl-l{display:flex;flex-direction:column;gap:9px}
#va-{{ section.id }} .r-hl-i{display:inline-flex;align-items:center;gap:8px;font-size:15px;color:#e6ebf5;line-height:1.5}
#va-{{ section.id }} .r-hl-i span{color:var(--star);font-size:14px;flex:none}
#va-{{ section.id }} .r-src{font-size:12.5px;color:#6b7690;margin-top:14px}

/* ---- liste ---- */
#va-{{ section.id }} .r-notice{margin-top:22px;display:flex;align-items:flex-start;gap:10px;
  border:1px solid #223049;border-radius:12px;background:#0d1424;padding:13px 16px}
#va-{{ section.id }} .r-notice svg{width:16px;height:16px;flex:none;margin-top:2px;fill:none;stroke:var(--cy);stroke-width:2;stroke-linecap:round}
#va-{{ section.id }} .r-notice p{font-size:13px;line-height:1.55;color:#9aa4bb}
#va-{{ section.id }} .r-from{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;letter-spacing:.04em;
  color:#8f9ab3;background:#131c2e;border:1px solid #223049;border-radius:999px;padding:3px 9px}
#va-{{ section.id }} .r-list{margin-top:36px}
#va-{{ section.id }} .r-item{padding:28px 0;border-top:1px solid #1c2335}
#va-{{ section.id }} .r-item:first-child{border-top:0}
#va-{{ section.id }} .r-stars{display:inline-flex;gap:3px;margin-bottom:14px}
#va-{{ section.id }} .r-stars svg{width:19px;height:19px;fill:var(--star)}
#va-{{ section.id }} .r-stars svg.off{fill:#2a3550}
#va-{{ section.id }} .r-who{font-size:15px;font-weight:800;margin-bottom:12px;display:flex;align-items:center;gap:9px;flex-wrap:wrap}
#va-{{ section.id }} .r-ok{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:800;letter-spacing:.06em;
  color:#39FF14;background:color-mix(in srgb,#39FF14 10%,transparent);border:1px solid color-mix(in srgb,#39FF14 32%,transparent);
  border-radius:999px;padding:3px 9px}
#va-{{ section.id }} .r-ok svg{width:11px;height:11px;fill:none;stroke:#39FF14;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}
#va-{{ section.id }} .r-t{font-size:19px;font-weight:800;margin-bottom:10px;line-height:1.3}
#va-{{ section.id }} .r-b{font-size:15px;line-height:1.65;color:#c9d1e4;max-width:860px}
#va-{{ section.id }} .r-pics{display:flex;gap:10px;margin-top:16px;flex-wrap:wrap}
#va-{{ section.id }} .r-pics img{width:132px;height:132px;object-fit:cover;border-radius:8px;display:block;background:#0d1424}

/* ---- état vide ---- */
#va-{{ section.id }} .r-item.r-hide{display:none}
#va-{{ section.id }} .r-item.r-reveal{animation:va-reveal-{{ section.id }} .45s cubic-bezier(.2,.9,.3,1) backwards;
  animation-delay:calc(var(--i,0) * .06s)}
@keyframes va-reveal-{{ section.id }}{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}

#va-{{ section.id }} .r-fade{position:relative;height:0}
#va-{{ section.id }} .r-fade.on{height:120px;margin-top:-120px;pointer-events:none;
  background:linear-gradient(180deg,transparent,{{ section.settings.bg }} 85%)}
#va-{{ section.id }} .r-more{display:flex;justify-content:center;margin-top:26px}
#va-{{ section.id }} .r-more button{display:inline-flex;align-items:center;justify-content:center;
  padding:15px 34px;border-radius:14px;border:0;background:var(--star);color:#0b1120;
  font:inherit;font-size:17px;font-weight:700;cursor:pointer;
  transition:filter .2s,transform .15s,box-shadow .2s}
#va-{{ section.id }} .r-more button:hover{filter:brightness(1.05);transform:translateY(-2px);
  box-shadow:0 6px 20px color-mix(in srgb,var(--star) 30%,transparent)}
#va-{{ section.id }} .r-more button:active{transform:translateY(0)}

#va-{{ section.id }} .r-empty{margin-top:30px;border:1px dashed #2a3550;border-radius:16px;padding:40px 28px;text-align:center}
#va-{{ section.id }} .r-empty p{color:#8f9ab3;font-size:15px;line-height:1.7;max-width:560px;margin:0 auto}
#va-{{ section.id }} .r-empty strong{color:#fff}

@media (max-width:749px){
  #va-{{ section.id }}{padding:40px 0 48px}
  #va-{{ section.id }} .r-in{padding:0 16px}
  #va-{{ section.id }} .r-top{flex-direction:column;align-items:stretch}
  #va-{{ section.id }} .r-acts{width:100%}
  #va-{{ section.id }} .r-write{flex:1}
  #va-{{ section.id }} .r-hl-i{font-size:14px;align-items:flex-start}
  #va-{{ section.id }} .r-t{font-size:17px}
  #va-{{ section.id }} .r-b{font-size:14.5px}
  #va-{{ section.id }} .r-pics img{width:104px;height:104px}
}

/* ---- menus filtre / tri ---- */
#va-{{ section.id }} .r-menu{position:relative}
#va-{{ section.id }} .r-pop{position:absolute;top:calc(100% + 8px);right:0;z-index:40;min-width:168px;
  background:#0d1424;border:1px solid #243049;border-radius:12px;padding:6px;
  box-shadow:0 18px 40px rgba(0,0,0,.55);display:flex;flex-direction:column;gap:2px}
#va-{{ section.id }} .r-pop[hidden]{display:none}
#va-{{ section.id }} .r-pop button{appearance:none;background:none;border:0;color:#c6cfe2;font:inherit;font-size:14px;
  text-align:left;padding:9px 12px;border-radius:8px;cursor:pointer;white-space:nowrap}
#va-{{ section.id }} .r-pop button:hover{background:#18233a;color:#fff}
#va-{{ section.id }} .r-pop button.on{background:#18233a;color:#fff;font-weight:700}
#va-{{ section.id }} .r-none{margin-top:28px;color:#8f9ab3;font-size:15px}
#va-{{ section.id }} .r-none[hidden]{display:none}
#va-{{ section.id }} .r-item.r-off{display:none}

/* ---- modale avis ---- */
#va-{{ section.id }} .r-modal{position:fixed;inset:0;z-index:9990;display:flex;align-items:center;justify-content:center;padding:20px}
#va-{{ section.id }} .r-modal[hidden]{display:none}
#va-{{ section.id }} .r-bd{position:absolute;inset:0;background:rgba(3,6,14,.78);backdrop-filter:blur(3px)}
#va-{{ section.id }} .r-dlg{position:relative;z-index:1;width:100%;max-width:520px;max-height:88vh;overflow-y:auto;
  background:#0b1223;border:1px solid #243049;border-radius:18px;padding:30px 28px 26px;
  box-shadow:0 30px 80px rgba(0,0,0,.6)}
#va-{{ section.id }} .r-x{position:absolute;top:14px;right:14px;width:34px;height:34px;display:grid;place-items:center;
  background:none;border:0;border-radius:9px;cursor:pointer;color:#8f9ab3}
#va-{{ section.id }} .r-x:hover{background:#18233a;color:#fff}
#va-{{ section.id }} .r-x svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}
#va-{{ section.id }} .r-ft{font-size:22px;font-weight:800;letter-spacing:-.01em;margin:0 0 22px;padding-right:36px}
#va-{{ section.id }} .r-lb{display:block;font-size:13px;font-weight:700;color:#c6cfe2;margin:0 0 7px;
  text-transform:uppercase;letter-spacing:.06em}
#va-{{ section.id }} .r-if{display:block;width:100%;margin:0 0 18px;background:#070d1a;color:#fff;
  border:1px solid #243049;border-radius:10px;padding:12px 14px;font:inherit;font-size:15px}
#va-{{ section.id }} .r-if:focus{outline:none;border-color:var(--cy);box-shadow:0 0 0 3px rgba(0,229,255,.14)}
#va-{{ section.id }} .r-ta{resize:vertical;min-height:120px;line-height:1.6}
#va-{{ section.id }} .r-rate{display:flex;gap:4px;margin:0 0 18px}
#va-{{ section.id }} .r-rate input{position:absolute;opacity:0;width:1px;height:1px;pointer-events:none}
#va-{{ section.id }} .r-rate label{cursor:pointer;line-height:0;padding:2px}
#va-{{ section.id }} .r-rate svg{width:30px;height:30px;fill:#273146;transition:fill .12s}
#va-{{ section.id }} .r-rate input:checked + label svg,
#va-{{ section.id }} .r-rate label.on svg{fill:var(--star)}
#va-{{ section.id }} .r-rate input:focus-visible + label svg{outline:2px solid var(--cy);outline-offset:2px}
#va-{{ section.id }} .r-ck{display:flex;gap:11px;align-items:flex-start;margin:0 0 22px;
  color:#8f9ab3;font-size:13.5px;line-height:1.6;cursor:pointer}
#va-{{ section.id }} .r-ck input{margin-top:3px;width:16px;height:16px;accent-color:var(--cy);flex:0 0 auto}
#va-{{ section.id }} .r-send{width:100%;appearance:none;border:0;border-radius:11px;cursor:pointer;
  background:var(--star);color:#0b1223;font:inherit;font-size:16px;font-weight:800;padding:15px 20px;
  transition:filter .18s,transform .14s}
#va-{{ section.id }} .r-send:hover{filter:brightness(1.06);transform:translateY(-1px)}
#va-{{ section.id }} .r-note{margin-top:16px !important;color:#78839c;font-size:12.5px;line-height:1.65}
#va-{{ section.id }} .r-done{color:#9fe8b4;font-size:16px;line-height:1.7;margin:0 0 6px !important}
#va-{{ section.id }} .r-err{background:rgba(255,90,90,.1);border:1px solid rgba(255,90,90,.35);color:#ffb3b3;
  border-radius:10px;padding:12px 14px;margin:0 0 18px !important;font-size:14px;line-height:1.6}
#va-{{ section.id }} .r-err ul{margin:0;padding-left:18px}

@media (max-width:749px){
  #va-{{ section.id }} .r-dlg{padding:26px 20px 22px;max-height:92vh}
  #va-{{ section.id }} .r-ft{font-size:19px}
  #va-{{ section.id }} .r-rate svg{width:34px;height:34px}
  #va-{{ section.id }} .r-pop{right:auto;left:0}
}
</style>

<section id="va-{{ section.id }}">
  <div class="r-in">

    <div class="r-top">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        {%- if has_data -%}
          <div class="r-score">
            <span class="r-big">{{ rating.rating | round: 1 }}</span>
            <span class="r-cnt">{{ rcount }} {% if rcount > 1 %}{{ section.settings.word_plural }}{% else %}{{ section.settings.word_single }}{% endif %}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="r-acts">
        {%- if section.settings.write_mode == 'link' -%}
          {%- if section.settings.write_link != blank -%}
            <a class="r-write" href="{{ section.settings.write_link }}">{{ section.settings.write_label }}</a>
          {%- endif -%}
        {%- elsif section.settings.write_mode == 'form' -%}
          <button type="button" class="r-write" data-r-open>{{ section.settings.write_label }}</button>
        {%- endif -%}

        <div class="r-menu">
          <button type="button" class="r-ico" aria-label="{{ section.settings.filter_aria }}" aria-haspopup="true" aria-expanded="false" data-r-tog="f">
            <svg viewBox="0 0 24 24"><path d="M3 5h18l-7 8v6l-4 2v-8z"/></svg>
          </button>
          <div class="r-pop" data-r-pop="f" hidden>
            <button type="button" class="on" data-r-f="all">{{ section.settings.filter_all }}</button>
            {%- for i in (1..5) -%}
              {%- assign n = 6 | minus: i -%}
              <button type="button" data-r-f="{{ n }}">{{ n }} &#9733;</button>
            {%- endfor -%}
          </div>
        </div>

        <div class="r-menu">
          <button type="button" class="r-ico" aria-label="{{ section.settings.sort_aria }}" aria-haspopup="true" aria-expanded="false" data-r-tog="s">
            <svg viewBox="0 0 24 24"><path d="M7 4v16M7 20l-3-3M7 4l3 3M17 20V4M17 4l3 3M17 20l-3-3"/></svg>
          </button>
          <div class="r-pop" data-r-pop="s" hidden>
            <button type="button" class="on" data-r-s="default">{{ section.settings.sort_recent }}</button>
            <button type="button" data-r-s="high">{{ section.settings.sort_high }}</button>
            <button type="button" data-r-s="low">{{ section.settings.sort_low }}</button>
          </div>
        </div>
      </div>
      <p class="r-none" data-r-none hidden>{{ section.settings.filter_none }}</p>
    </div>

    {%- assign hl = 0 -%}
    {%- for block in section.blocks -%}{%- if block.type == 'highlight' -%}{%- assign hl = hl | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- if hl > 0 -%}
      <div class="r-hl">
        <p class="r-hl-t">{{ section.settings.highlights_title }}</p>
        <div class="r-hl-l">
          {%- for block in section.blocks -%}
            {%- if block.type == 'highlight' -%}
              <p class="r-hl-i" {{ block.shopify_attributes }}>« {{ block.settings.quote }} »<span>›</span></p>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.highlights_source != blank -%}
          <p class="r-src">{{ section.settings.highlights_source }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.source_notice != blank -%}
      <div class="r-notice">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 16v-5M12 8h.01"/></svg>
        <p>{{ section.settings.source_notice }}</p>
      </div>
    {%- endif -%}

    {%- comment -%} Emplacement de l'application d'avis : Judge.me, Loox, Okendo... {%- endcomment -%}
    {%- if section.settings.app_embed != blank -%}
      <div class="r-list">{{ section.settings.app_embed }}</div>
    {%- endif -%}

    {%- comment -%} Avis saisis en masse : nom|note|titre|texte|source par ligne {%- endcomment -%}
    {%- assign bulk_rows = section.settings.bulk | strip | newline_to_br | split: '<br />' -%}
    {%- assign bulk_n = 0 -%}
    {%- for row in bulk_rows -%}{%- assign rr = row | strip -%}{%- if rr != blank -%}{%- assign bulk_n = bulk_n | plus: 1 -%}{%- endif -%}{%- endfor -%}

    {%- assign cut = section.settings.visible_count -%}
    {%- assign rv = 0 -%}
    {%- for block in section.blocks -%}{%- if block.type == 'review' -%}{%- assign rv = rv | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- if bulk_n > 0 -%}
      <div class="r-list" data-r-list>
        {%- assign shown = 0 -%}
        {%- for row in bulk_rows -%}
          {%- assign rr = row | strip -%}
          {%- if rr != blank -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- assign c = rr | split: '|' -%}
            {%- assign n_stars = c[1] | plus: 0 -%}
            {%- if n_stars < 1 -%}{%- assign n_stars = 5 -%}{%- endif -%}
            <div class="r-item{% if shown > cut %} r-hide{% endif %}" data-stars="{{ n_stars }}"{% if shown > cut %} data-r-extra{% endif %}>
              <div class="r-stars" role="img" aria-label="{{ n_stars }} étoiles sur 5">
                {%- for i in (1..5) -%}
                  <svg viewBox="0 0 24 24" class="{% if i > n_stars %}off{% endif %}">
                    <path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/>
                  </svg>
                {%- endfor -%}
              </div>
              <div class="r-who">
                {{ c[0] | strip }}
                {%- assign src = c[4] | strip -%}
                {%- if src != blank -%}<span class="r-from">{{ section.settings.from_word }} {{ src }}</span>{%- endif -%}
              </div>
              {%- assign ttl = c[2] | strip -%}
              {%- if ttl != blank -%}<p class="r-t">{{ ttl }}</p>{%- endif -%}
              <p class="r-b">{{ c[3] | strip }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}


    {%- if rv > 0 -%}
      <div class="r-list" data-r-list>
        {%- assign shown = bulk_n -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            {%- assign shown = shown | plus: 1 -%}
            <div class="r-item{% if shown > cut %} r-hide{% endif %}" data-stars="{{ block.settings.stars }}"{% if shown > cut %} data-r-extra{% endif %} {{ block.shopify_attributes }}>
              <div class="r-stars" role="img" aria-label="{{ block.settings.stars }} étoiles sur 5">
                {%- for i in (1..5) -%}
                  <svg viewBox="0 0 24 24" class="{% if i > block.settings.stars %}off{% endif %}">
                    <path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/>
                  </svg>
                {%- endfor -%}
              </div>
              <div class="r-who">
                {{ block.settings.author }}
                {%- if block.settings.verified -%}
                  <span class="r-ok"><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>{{ section.settings.verified_label }}</span>
                {%- endif -%}
                {%- if block.settings.source != blank -%}
                  <span class="r-from">{{ section.settings.from_word }} {{ block.settings.source }}</span>
                {%- endif -%}
              </div>
              {%- if block.settings.title != blank -%}<p class="r-t">{{ block.settings.title }}</p>{%- endif -%}
              <p class="r-b">{{ block.settings.body }}</p>
              {%- if block.settings.photo or block.settings.photo_2 -%}
                <div class="r-pics">
                  {%- if block.settings.photo -%}
                    {{ block.settings.photo | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.author }}
                  {%- endif -%}
                  {%- if block.settings.photo_2 -%}
                    {{ block.settings.photo_2 | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.author }}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign total = bulk_n | plus: rv -%}
    {%- if total > cut -%}
      {%- assign rest = total | minus: cut -%}
      <div class="r-fade on" data-r-fade></div>
      <div class="r-more">
        <button type="button" data-r-more aria-expanded="false">
          <span data-r-label>{{ section.settings.more_label }}</span>
        </button>
      </div>
    {%- endif -%}

    {%- if rv == 0 and bulk_n == 0 and section.settings.app_embed == blank -%}
      <div class="r-empty">
        <p>{{ section.settings.empty_text }}</p>
      </div>
    {%- endif -%}

  </div>

  {%- if section.settings.write_mode == 'form' -%}
    <div class="r-modal" data-r-modal hidden>
      <div class="r-bd" data-r-close></div>
      <div class="r-dlg" role="dialog" aria-modal="true" aria-labelledby="rft-{{ section.id }}">
        <button type="button" class="r-x" data-r-close aria-label="{{ section.settings.f_close }}">
          <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
        <p class="r-ft" id="rft-{{ section.id }}">{{ section.settings.form_title }}</p>

        {%- form 'contact' -%}
          {%- if form.posted_successfully? -%}
            <span data-r-posted hidden></span>
            <p class="r-done">{{ section.settings.form_done }}</p>
          {%- else -%}
            {%- if form.errors -%}
              <p class="r-err">{{ form.errors | default_errors }}</p>
            {%- endif -%}

            <label class="r-lb" for="rn-{{ section.id }}">{{ section.settings.f_name }}</label>
            <input class="r-if" id="rn-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" required>

            <label class="r-lb" for="re-{{ section.id }}">{{ section.settings.f_email }}</label>
            <input class="r-if" id="re-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required>

            <span class="r-lb">{{ section.settings.f_rating }}</span>
            <div class="r-rate" data-r-rate>
              {%- for i in (1..5) -%}
                <input type="radio" name="contact[Note]" id="rr{{ i }}-{{ section.id }}" value="{{ i }}" required>
                <label for="rr{{ i }}-{{ section.id }}" aria-label="{{ i }}/5">
                  <svg viewBox="0 0 24 24"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg>
                </label>
              {%- endfor -%}
            </div>

            <label class="r-lb" for="rt-{{ section.id }}">{{ section.settings.f_title }}</label>
            <input class="r-if" id="rt-{{ section.id }}" type="text" name="contact[Titre]">

            <label class="r-lb" for="rb-{{ section.id }}">{{ section.settings.f_body }}</label>
            <textarea class="r-if r-ta" id="rb-{{ section.id }}" name="contact[body]" rows="5" required></textarea>

            <label class="r-ck">
              <input type="checkbox" name="contact[Consentement]" value="oui" required>
              <span>{{ section.settings.f_consent }}</span>
            </label>

            <button type="submit" class="r-send">{{ section.settings.f_submit }}</button>
            <p class="r-note">{{ section.settings.form_notice }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  {%- endif -%}
</section>

<script>
(function () {
  var root = document.getElementById('va-{{ section.id }}');
  if (!root) return;
  var btn = root.querySelector('[data-r-more]');
  if (!btn) return;

  var extra = [].slice.call(root.querySelectorAll('[data-r-extra]'));
  var fade  = root.querySelector('[data-r-fade]');
  var label = root.querySelector('[data-r-label]');
  var more  = {{ section.settings.more_label | json }};
  var less  = {{ section.settings.less_label | json }};
  var rest  = extra.length;
  var open  = false;
  var STEP  = {{ section.settings.step_count | default: 6 }};
  var at    = 0;

  btn.addEventListener('click', function () {
    if (!open) {
      var batch = extra.slice(at, at + STEP);
      batch.forEach(function (el, k) {
        el.style.setProperty('--i', k);
        el.classList.remove('r-hide');
        el.classList.add('r-reveal');
        el.addEventListener('animationend', function h() {
          el.classList.remove('r-reveal');
          el.removeEventListener('animationend', h);
        });
      });
      at += batch.length;

      if (at >= rest) {
        open = true;
        at = rest;
        fade.classList.remove('on');
        label.textContent = less;
        btn.setAttribute('aria-expanded', 'true');
      }
    } else {
      extra.forEach(function (el) { el.classList.add('r-hide'); });
      at = 0;
      open = false;
      fade.classList.add('on');
      label.textContent = more;
      btn.setAttribute('aria-expanded', 'false');
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });
})();
</script>

<script>
(function () {
  var root = document.getElementById('va-{{ section.id }}');
  if (!root) return;

  /* ---------- menus filtre / tri ---------- */
  var lists = [].slice.call(root.querySelectorAll('[data-r-list]'));
  var none = root.querySelector('[data-r-none]');
  var pops = [].slice.call(root.querySelectorAll('[data-r-pop]'));

  function closeAll(except) {
    pops.forEach(function (p) {
      if (p === except) return;
      p.hidden = true;
      var t = root.querySelector('[data-r-tog="' + p.getAttribute('data-r-pop') + '"]');
      if (t) t.setAttribute('aria-expanded', 'false');
    });
  }

  root.querySelectorAll('[data-r-tog]').forEach(function (tog) {
    tog.addEventListener('click', function (e) {
      e.stopPropagation();
      var pop = root.querySelector('[data-r-pop="' + tog.getAttribute('data-r-tog') + '"]');
      if (!pop) return;
      var willOpen = pop.hidden;
      closeAll(pop);
      pop.hidden = !willOpen;
      tog.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
    });
  });
  document.addEventListener('click', function () { closeAll(null); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(null); });
  pops.forEach(function (p) { p.addEventListener('click', function (e) { e.stopPropagation(); }); });

  function items() {
    var all = [];
    lists.forEach(function (l) { all = all.concat([].slice.call(l.querySelectorAll('.r-item'))); });
    return all;
  }

  var filter = 'all';
  function applyFilter() {
    var on = 0;
    items().forEach(function (el) {
      var ok = (filter === 'all') || (el.getAttribute('data-stars') === filter);
      el.classList.toggle('r-off', !ok);
      if (ok) on++;
    });
    if (none) none.hidden = on !== 0;
  }

  root.querySelectorAll('[data-r-f]').forEach(function (b) {
    b.addEventListener('click', function () {
      filter = b.getAttribute('data-r-f');
      b.parentNode.querySelectorAll('button').forEach(function (o) { o.classList.remove('on'); });
      b.classList.add('on');
      applyFilter();
      closeAll(null);
    });
  });

  var base = null;
  root.querySelectorAll('[data-r-s]').forEach(function (b) {
    b.addEventListener('click', function () {
      if (!lists.length) return;
      if (!base) base = items();
      var how = b.getAttribute('data-r-s');
      var arr = base.slice();
      if (how === 'high' || how === 'low') {
        arr.sort(function (x, y) {
          var a = parseInt(x.getAttribute('data-stars'), 10) || 0;
          var c = parseInt(y.getAttribute('data-stars'), 10) || 0;
          return how === 'high' ? c - a : a - c;
        });
      }
      arr.forEach(function (el) { lists[0].appendChild(el); });
      b.parentNode.querySelectorAll('button').forEach(function (o) { o.classList.remove('on'); });
      b.classList.add('on');
      closeAll(null);
    });
  });

  /* ---------- modale ---------- */
  var modal = root.querySelector('[data-r-modal]');
  if (!modal) return;
  var last = null;

  function open() {
    last = document.activeElement;
    modal.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    var f = modal.querySelector('input, textarea, button');
    if (f) f.focus();
  }
  function close() {
    modal.hidden = true;
    document.documentElement.style.overflow = '';
    if (last && last.focus) last.focus();
  }

  root.querySelectorAll('[data-r-open]').forEach(function (b) {
    b.addEventListener('click', open);
  });
  modal.querySelectorAll('[data-r-close]').forEach(function (b) {
    b.addEventListener('click', close);
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !modal.hidden) close();
  });

  if (modal.querySelector('[data-r-posted]')) open();

  /* ---------- etoiles du formulaire ---------- */
  var rate = modal.querySelector('[data-r-rate]');
  if (rate) {
    var labels = [].slice.call(rate.querySelectorAll('label'));
    function paint(n) {
      labels.forEach(function (l, i) { l.classList.toggle('on', i < n); });
    }
    labels.forEach(function (l, i) {
      l.addEventListener('mouseenter', function () { paint(i + 1); });
      l.addEventListener('click', function () { paint(i + 1); });
    });
    rate.addEventListener('mouseleave', function () {
      var c = rate.querySelector('input:checked');
      paint(c ? parseInt(c.value, 10) : 0);
    });
  }
})();
</script>

