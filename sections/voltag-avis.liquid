{%- comment -%} VOLTAG — Avis | sections/voltag-avis.liquid {%- endcomment -%}

{%- liquid
  assign rating = product.metafields.reviews.rating.value
  assign rcount = product.metafields.reviews.rating_count.value | default: 0
  assign has_data = false
  if rating != blank and rcount > 0
    assign has_data = true
  endif
-%}

<style>
#va-{{ section.id }}{--cy:{{ section.settings.accent }};--star:{{ section.settings.star_color }};
  background:{{ section.settings.bg }};color:#fff;padding:56px 0 64px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif}
#va-{{ section.id }} *{box-sizing:border-box}
#va-{{ section.id }} p{margin:0}
#va-{{ section.id }} .r-in{max-width:1120px;margin:0 auto;padding:0 24px}

/* ---- en-tête ---- */
#va-{{ section.id }} .r-top{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;flex-wrap:wrap}
#va-{{ section.id }} h2{margin:0;font-size:clamp(24px,3.2vw,30px);font-weight:800;letter-spacing:-.01em}
#va-{{ section.id }} .r-score{display:flex;align-items:baseline;gap:10px;margin-top:10px}
#va-{{ section.id }} .r-big{font-size:30px;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}
#va-{{ section.id }} .r-cnt{font-size:14px;color:#8f9ab3}
#va-{{ section.id }} .r-acts{display:flex;align-items:center;gap:10px}
#va-{{ section.id }} .r-write{display:inline-flex;align-items:center;justify-content:center;padding:13px 26px;border-radius:10px;
  background:var(--star);color:#0b1120;font:inherit;font-size:15px;font-weight:800;text-decoration:none;border:0;cursor:pointer}
#va-{{ section.id }} .r-write:hover{filter:brightness(1.06)}
#va-{{ section.id }} .r-ico{display:grid;place-items:center;width:44px;height:44px;border-radius:10px;border:1px solid #2a3550;
  background:transparent;color:#fff;cursor:pointer}
#va-{{ section.id }} .r-ico svg{width:18px;height:18px;fill:none;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
#va-{{ section.id }} .r-ico:hover{border-color:var(--cy)}

/* ---- points forts ---- */
#va-{{ section.id }} .r-hl{margin-top:26px}
#va-{{ section.id }} .r-hl-t{font-size:15px;font-weight:800;margin-bottom:12px}
#va-{{ section.id }} .r-hl-l{display:flex;flex-direction:column;gap:9px}
#va-{{ section.id }} .r-hl-i{display:inline-flex;align-items:center;gap:8px;font-size:15px;color:#e6ebf5;line-height:1.5}
#va-{{ section.id }} .r-hl-i span{color:var(--star);font-size:14px;flex:none}
#va-{{ section.id }} .r-src{font-size:12.5px;color:#6b7690;margin-top:14px}

/* ---- liste ---- */
#va-{{ section.id }} .r-list{margin-top:36px}
#va-{{ section.id }} .r-item{padding:28px 0;border-top:1px solid #1c2335}
#va-{{ section.id }} .r-item:first-child{border-top:0}
#va-{{ section.id }} .r-stars{display:inline-flex;gap:3px;margin-bottom:14px}
#va-{{ section.id }} .r-stars svg{width:19px;height:19px;fill:var(--star)}
#va-{{ section.id }} .r-stars svg.off{fill:#2a3550}
#va-{{ section.id }} .r-who{font-size:15px;font-weight:800;margin-bottom:12px;display:flex;align-items:center;gap:9px;flex-wrap:wrap}
#va-{{ section.id }} .r-ok{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:800;letter-spacing:.06em;
  color:#39FF14;background:color-mix(in srgb,#39FF14 10%,transparent);border:1px solid color-mix(in srgb,#39FF14 32%,transparent);
  border-radius:999px;padding:3px 9px}
#va-{{ section.id }} .r-ok svg{width:11px;height:11px;fill:none;stroke:#39FF14;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}
#va-{{ section.id }} .r-t{font-size:19px;font-weight:800;margin-bottom:10px;line-height:1.3}
#va-{{ section.id }} .r-b{font-size:15px;line-height:1.65;color:#c9d1e4;max-width:860px}
#va-{{ section.id }} .r-pics{display:flex;gap:10px;margin-top:16px;flex-wrap:wrap}
#va-{{ section.id }} .r-pics img{width:132px;height:132px;object-fit:cover;border-radius:8px;display:block;background:#0d1424}

/* ---- état vide ---- */
#va-{{ section.id }} .r-empty{margin-top:30px;border:1px dashed #2a3550;border-radius:16px;padding:40px 28px;text-align:center}
#va-{{ section.id }} .r-empty p{color:#8f9ab3;font-size:15px;line-height:1.7;max-width:560px;margin:0 auto}
#va-{{ section.id }} .r-empty strong{color:#fff}

@media (max-width:749px){
  #va-{{ section.id }}{padding:40px 0 48px}
  #va-{{ section.id }} .r-in{padding:0 16px}
  #va-{{ section.id }} .r-top{flex-direction:column;align-items:stretch}
  #va-{{ section.id }} .r-acts{width:100%}
  #va-{{ section.id }} .r-write{flex:1}
  #va-{{ section.id }} .r-hl-i{font-size:14px;align-items:flex-start}
  #va-{{ section.id }} .r-t{font-size:17px}
  #va-{{ section.id }} .r-b{font-size:14.5px}
  #va-{{ section.id }} .r-pics img{width:104px;height:104px}
}
</style>

<section id="va-{{ section.id }}">
  <div class="r-in">

    <div class="r-top">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        {%- if has_data -%}
          <div class="r-score">
            <span class="r-big">{{ rating.rating | round: 1 }}</span>
            <span class="r-cnt">{{ rcount }} {% if rcount > 1 %}{{ section.settings.word_plural }}{% else %}{{ section.settings.word_single }}{% endif %}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="r-acts">
        {%- if section.settings.write_link != blank -%}
          <a class="r-write" href="{{ section.settings.write_link }}">{{ section.settings.write_label }}</a>
        {%- endif -%}
        <button type="button" class="r-ico" aria-label="Filtrer">
          <svg viewBox="0 0 24 24"><path d="M3 5h18l-7 8v6l-4 2v-8z"/></svg>
        </button>
        <button type="button" class="r-ico" aria-label="Trier">
          <svg viewBox="0 0 24 24"><path d="M7 4v16M7 20l-3-3M7 4l3 3M17 20V4M17 4l3 3M17 20l-3-3"/></svg>
        </button>
      </div>
    </div>

    {%- assign hl = 0 -%}
    {%- for block in section.blocks -%}{%- if block.type == 'highlight' -%}{%- assign hl = hl | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- if hl > 0 -%}
      <div class="r-hl">
        <p class="r-hl-t">{{ section.settings.highlights_title }}</p>
        <div class="r-hl-l">
          {%- for block in section.blocks -%}
            {%- if block.type == 'highlight' -%}
              <p class="r-hl-i" {{ block.shopify_attributes }}>« {{ block.settings.quote }} »<span>›</span></p>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.highlights_source != blank -%}
          <p class="r-src">{{ section.settings.highlights_source }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Emplacement de l'application d'avis : Judge.me, Loox, Okendo... {%- endcomment -%}
    {%- if section.settings.app_embed != blank -%}
      <div class="r-list">{{ section.settings.app_embed }}</div>
    {%- endif -%}

    {%- assign rv = 0 -%}
    {%- for block in section.blocks -%}{%- if block.type == 'review' -%}{%- assign rv = rv | plus: 1 -%}{%- endif -%}{%- endfor -%}

    {%- if rv > 0 -%}
      <div class="r-list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <div class="r-item" {{ block.shopify_attributes }}>
              <div class="r-stars" role="img" aria-label="{{ block.settings.stars }} étoiles sur 5">
                {%- for i in (1..5) -%}
                  <svg viewBox="0 0 24 24" class="{% if i > block.settings.stars %}off{% endif %}">
                    <path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/>
                  </svg>
                {%- endfor -%}
              </div>
              <div class="r-who">
                {{ block.settings.author }}
                {%- if block.settings.verified -%}
                  <span class="r-ok"><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>{{ section.settings.verified_label }}</span>
                {%- endif -%}
              </div>
              {%- if block.settings.title != blank -%}<p class="r-t">{{ block.settings.title }}</p>{%- endif -%}
              <p class="r-b">{{ block.settings.body }}</p>
              {%- if block.settings.photo or block.settings.photo_2 -%}
                <div class="r-pics">
                  {%- if block.settings.photo -%}
                    {{ block.settings.photo | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.author }}
                  {%- endif -%}
                  {%- if block.settings.photo_2 -%}
                    {{ block.settings.photo_2 | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.author }}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if rv == 0 and section.settings.app_embed == blank -%}
      <div class="r-empty">
        <p>{{ section.settings.empty_text }}</p>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "VOLTAG — Avis",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Les avis affichés doivent provenir de clients réels. Publier des avis inventés est une pratique commerciale trompeuse sanctionnée par le code de la consommation." },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#05060A" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#00E5FF" },
    { "type": "color", "id": "star_color", "label": "Couleur des étoiles", "default": "#FFD60A" },

    { "type": "header", "content": "En-tête" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Avis clients" },
    { "type": "text", "id": "word_single", "label": "Mot au singulier", "default": "avis" },
    { "type": "text", "id": "word_plural", "label": "Mot au pluriel", "default": "avis" },
    { "type": "text", "id": "write_label", "label": "Bouton", "default": "Donner mon avis" },
    { "type": "url", "id": "write_link", "label": "Lien du bouton" },
    { "type": "text", "id": "verified_label", "label": "Mention achat vérifié", "default": "ACHAT VÉRIFIÉ" },

    { "type": "header", "content": "Points forts" },
    { "type": "text", "id": "highlights_title", "label": "Titre", "default": "Ce qui revient le plus" },
    { "type": "text", "id": "highlights_source", "label": "Mention de provenance",
      "info": "Indiquez d'où viennent ces extraits. S'ils sont choisis par vos soins, dites-le.",
      "default": "Extraits choisis parmi les avis reçus ces derniers mois" },

    { "type": "header", "content": "Application d'avis" },
    { "type": "liquid", "id": "app_embed", "label": "Code de l'application",
      "info": "Collez ici le bloc fourni par Judge.me, Loox ou Okendo. La note et le nombre d'avis en haut se remplissent automatiquement dès que l'application est installée." },

    { "type": "header", "content": "Quand il n'y a encore aucun avis" },
    { "type": "textarea", "id": "empty_text", "label": "Message",
      "default": "Les premiers avis arriveront après vos premières commandes. Installez une application d'avis pour les collecter automatiquement après livraison." }
  ],
  "blocks": [
    { "type": "highlight", "name": "Point fort", "limit": 5, "settings": [
      { "type": "text", "id": "quote", "label": "Extrait d'avis",
        "info": "Citez un avis réellement reçu, sans le reformuler." }
    ]},
    { "type": "review", "name": "Avis", "settings": [
      { "type": "paragraph", "content": "À remplir uniquement avec un avis réellement reçu d'un client." },
      { "type": "text", "id": "author", "label": "Auteur", "default": "Prénom N." },
      { "type": "range", "id": "stars", "label": "Note", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "checkbox", "id": "verified", "label": "Achat vérifié", "default": false },
      { "type": "text", "id": "title", "label": "Titre de l'avis" },
      { "type": "textarea", "id": "body", "label": "Avis", "default": "Texte de l'avis." },
      { "type": "image_picker", "id": "photo", "label": "Photo du client" },
      { "type": "image_picker", "id": "photo_2", "label": "Deuxième photo" }
    ]}
  ],
  "presets": [
    { "name": "VOLTAG — Avis" }
  ]
}
{% endschema %}
