{%- comment -%} VOLTAG — Contact | sections/voltag-contact.liquid {%- endcomment -%}

<style>
#vk-{{ section.id }}{--cy:{{ section.settings.accent }};--star:{{ section.settings.btn_color }};
  background:{{ section.settings.bg }};color:#fff;padding:64px 0 72px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif}
#vk-{{ section.id }} *{box-sizing:border-box}
#vk-{{ section.id }} p{margin:0}
#vk-{{ section.id }} .k-in{max-width:1080px;margin:0 auto;padding:0 20px}
#vk-{{ section.id }} .k-eye{font-size:12px;font-weight:800;letter-spacing:.2em;color:var(--cy);
  text-shadow:0 0 10px color-mix(in srgb,var(--cy) 50%,transparent);margin-bottom:12px}
#vk-{{ section.id }} h1,#vk-{{ section.id }} h2{margin:0;font-size:clamp(28px,4.4vw,44px);font-weight:800;
  letter-spacing:-.02em;line-height:1.08;text-wrap:balance}
#vk-{{ section.id }} .k-lz{display:block;width:min(220px,55%);height:3px;margin:16px 0 20px;border-radius:3px;
  background:linear-gradient(90deg,transparent,#FF2D55,#FFD60A,#39FF14,#00A3FF,transparent);
  background-size:200% 100%;animation:vk-flow-{{ section.id }} 3s linear infinite}
#vk-{{ section.id }} .k-sub{color:#9aa4bb;font-size:16px;line-height:1.65;max-width:620px}

#vk-{{ section.id }} .k-grid{display:grid;grid-template-columns:1fr;gap:28px;margin-top:40px}
@media (min-width:900px){#vk-{{ section.id }} .k-grid{grid-template-columns:1.25fr .75fr;gap:44px;align-items:start}}

#vk-{{ section.id }} .k-card{border:1px solid #1c2335;border-radius:18px;background:#0d1424;padding:28px}
#vk-{{ section.id }} .k-row{display:grid;grid-template-columns:1fr;gap:16px}
@media (min-width:600px){#vk-{{ section.id }} .k-row.two{grid-template-columns:1fr 1fr}}
#vk-{{ section.id }} label{display:block;font-size:12.5px;font-weight:800;letter-spacing:.08em;
  text-transform:uppercase;color:#8f9ab3;margin-bottom:7px}
#vk-{{ section.id }} input,#vk-{{ section.id }} textarea,#vk-{{ section.id }} select{
  width:100%;background:#0b1120;border:1px solid #223049;border-radius:11px;color:#fff;
  font:inherit;font-size:15px;padding:13px 15px;transition:border-color .2s,box-shadow .2s}
#vk-{{ section.id }} input:focus,#vk-{{ section.id }} textarea:focus,#vk-{{ section.id }} select:focus{
  outline:0;border-color:var(--cy);box-shadow:0 0 0 3px color-mix(in srgb,var(--cy) 18%,transparent)}
#vk-{{ section.id }} textarea{min-height:150px;resize:vertical;line-height:1.6}
#vk-{{ section.id }} .k-send{margin-top:22px;display:inline-flex;align-items:center;justify-content:center;
  padding:15px 34px;border-radius:14px;border:0;background:var(--star);color:#0b1120;
  font:inherit;font-size:16px;font-weight:700;cursor:pointer;transition:filter .2s,transform .15s,box-shadow .2s}
#vk-{{ section.id }} .k-send:hover{filter:brightness(1.05);transform:translateY(-2px);
  box-shadow:0 6px 20px color-mix(in srgb,var(--star) 30%,transparent)}
#vk-{{ section.id }} .k-note{margin-top:14px;font-size:12.5px;color:#6b7690;line-height:1.6}

#vk-{{ section.id }} .k-ok,#vk-{{ section.id }} .k-err{display:flex;gap:11px;align-items:flex-start;
  border-radius:12px;padding:14px 16px;margin-bottom:20px;font-size:14.5px;line-height:1.55}
#vk-{{ section.id }} .k-ok{border:1px solid color-mix(in srgb,#39FF14 35%,transparent);
  background:color-mix(in srgb,#39FF14 8%,transparent);color:#c9f7da}
#vk-{{ section.id }} .k-err{border:1px solid color-mix(in srgb,#FF2D55 35%,transparent);
  background:color-mix(in srgb,#FF2D55 8%,transparent);color:#ffd2da}
#vk-{{ section.id }} .k-ok svg,#vk-{{ section.id }} .k-err svg{width:17px;height:17px;flex:none;margin-top:1px;
  fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
#vk-{{ section.id }} .k-ok svg{stroke:#39FF14}
#vk-{{ section.id }} .k-err svg{stroke:#FF2D55}
#vk-{{ section.id }} .k-err ul{margin:4px 0 0;padding-left:18px}

#vk-{{ section.id }} .k-info{display:grid;gap:12px}
#vk-{{ section.id }} .k-item{display:flex;gap:14px;align-items:flex-start;border:1px solid #1c2335;
  border-radius:14px;background:#0d1424;padding:18px}
#vk-{{ section.id }} .k-ico{flex:none;display:grid;place-items:center;width:38px;height:38px;border-radius:50%;
  background:color-mix(in srgb,var(--cy) 9%,transparent);border:1px solid color-mix(in srgb,var(--cy) 32%,transparent)}
#vk-{{ section.id }} .k-ico svg{width:17px;height:17px;fill:none;stroke:var(--cy);stroke-width:2;
  stroke-linecap:round;stroke-linejoin:round}
#vk-{{ section.id }} .k-item b{display:block;font-size:14.5px;font-weight:800;margin-bottom:4px}
#vk-{{ section.id }} .k-item span{display:block;font-size:14px;color:#9aa4bb;line-height:1.55}
#vk-{{ section.id }} .k-item a{color:var(--cy);text-decoration:none}
#vk-{{ section.id }} .k-item a:hover{text-decoration:underline}

@keyframes vk-flow-{{ section.id }}{to{background-position:200% 0}}
@media (prefers-reduced-motion:reduce){#vk-{{ section.id }} .k-lz{animation:none}}
@media (max-width:749px){
  #vk-{{ section.id }}{padding:44px 0 52px}
  #vk-{{ section.id }} .k-in{padding:0 16px}
  #vk-{{ section.id }} .k-card{padding:20px}
  #vk-{{ section.id }} .k-send{width:100%}
}
</style>

<section id="vk-{{ section.id }}">
  <div class="k-in">
    {%- if section.settings.eyebrow != blank -%}<p class="k-eye">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.use_h1 -%}
      <h1>{{ section.settings.heading }}</h1>
    {%- else -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    <span class="k-lz" aria-hidden="true"></span>
    {%- if section.settings.sub != blank -%}<p class="k-sub">{{ section.settings.sub }}</p>{%- endif -%}

    <div class="k-grid">
      <div class="k-card">
        {%- form 'contact', id: 'voltag-contact' -%}
          {%- if form.posted_successfully? -%}
            <div class="k-ok">
              <svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
              <span>{{ section.settings.success_text }}</span>
            </div>
          {%- elsif form.errors -%}
            <div class="k-err">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
              <span>
                {{ section.settings.error_text }}
                <ul>
                  {%- for field in form.errors -%}
                    <li>{{ form.errors.messages[field] }}</li>
                  {%- endfor -%}
                </ul>
              </span>
            </div>
          {%- endif -%}

          <div class="k-row two">
            <div>
              <label for="vk-name-{{ section.id }}">{{ section.settings.l_name }}</label>
              <input type="text" id="vk-name-{{ section.id }}" name="contact[Nom]"
                     value="{{ form.name }}" autocomplete="name" required>
            </div>
            <div>
              <label for="vk-mail-{{ section.id }}">{{ section.settings.l_email }}</label>
              <input type="email" id="vk-mail-{{ section.id }}" name="contact[email]"
                     value="{{ form.email }}" autocomplete="email" required>
            </div>
          </div>

          <div class="k-row two" style="margin-top:16px">
            <div>
              <label for="vk-order-{{ section.id }}">{{ section.settings.l_order }}</label>
              <input type="text" id="vk-order-{{ section.id }}" name="contact[Numéro de commande]"
                     placeholder="{{ section.settings.ph_order }}">
            </div>
            <div>
              <label for="vk-topic-{{ section.id }}">{{ section.settings.l_topic }}</label>
              <select id="vk-topic-{{ section.id }}" name="contact[Sujet]">
                {%- assign topics = section.settings.topics | split: ',' -%}
                {%- for topic in topics -%}
                  <option value="{{ topic | strip | escape }}">{{ topic | strip }}</option>
                {%- endfor -%}
              </select>
            </div>
          </div>

          <div style="margin-top:16px">
            <label for="vk-msg-{{ section.id }}">{{ section.settings.l_message }}</label>
            <textarea id="vk-msg-{{ section.id }}" name="contact[body]" required>{{ form.body }}</textarea>
          </div>

          <button type="submit" class="k-send">{{ section.settings.send_label }}</button>
          {%- if section.settings.rgpd != blank -%}
            <p class="k-note">{{ section.settings.rgpd }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>

      <div class="k-info">
        {%- for block in section.blocks -%}
          <div class="k-item" {{ block.shopify_attributes }}>
            <span class="k-ico" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'clock' -%}
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24"><path d="M2 7h11v9H2zM13 10h4l4 3v3h-8z"/><circle cx="6.5" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
                {%- when 'back' -%}
                  <svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 3-6.7M3 4v5h5"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24"><path d="M3 6h18v12H3z"/><path d="m3 7 9 6 9-6"/></svg>
              {%- endcase -%}
            </span>
            <span>
              <b>{{ block.settings.title }}</b>
              <span>{{ block.settings.text }}</span>
            </span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VOLTAG — Contact",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg", "label": "Fond", "default": "#05060A" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#00E5FF" },
    { "type": "color", "id": "btn_color", "label": "Couleur du bouton", "default": "#FFD60A" },
    { "type": "checkbox", "id": "use_h1", "label": "Titre en H1", "default": true,
      "info": "À activer sur la page Contact, à désactiver si la section est ajoutée ailleurs." },

    { "type": "header", "content": "Textes" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "UNE QUESTION ?" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Écrivez-nous" },
    { "type": "textarea", "id": "sub", "label": "Introduction",
      "default": "Une question sur un pack, une commande en cours ou un problème technique ? Écrivez-nous et nous répondons sous 24 heures ouvrées." },

    { "type": "header", "content": "Formulaire" },
    { "type": "text", "id": "l_name", "label": "Libellé nom", "default": "Votre nom" },
    { "type": "text", "id": "l_email", "label": "Libellé e-mail", "default": "Votre e-mail" },
    { "type": "text", "id": "l_order", "label": "Libellé commande", "default": "Numéro de commande" },
    { "type": "text", "id": "ph_order", "label": "Exemple commande", "default": "Facultatif, ex. #1042" },
    { "type": "text", "id": "l_topic", "label": "Libellé sujet", "default": "Sujet" },
    { "type": "textarea", "id": "topics", "label": "Sujets proposés",
      "info": "Séparés par des virgules.",
      "default": "Question avant achat, Suivi de ma commande, Problème technique, Retour ou échange, Autre" },
    { "type": "text", "id": "l_message", "label": "Libellé message", "default": "Votre message" },
    { "type": "text", "id": "send_label", "label": "Bouton", "default": "Envoyer le message" },
    { "type": "textarea", "id": "rgpd", "label": "Mention sous le bouton",
      "default": "Vos informations servent uniquement à traiter votre demande. Vous pouvez demander leur suppression à tout moment." },

    { "type": "header", "content": "Messages du formulaire" },
    { "type": "textarea", "id": "success_text", "label": "Confirmation",
      "default": "Message bien reçu. Nous vous répondons sous 24 heures ouvrées, pensez à vérifier vos courriers indésirables." },
    { "type": "text", "id": "error_text", "label": "Erreur", "default": "Le message n'a pas pu être envoyé :" }
  ],
  "blocks": [
    { "type": "info", "name": "Information", "limit": 4, "settings": [
      { "type": "select", "id": "icon", "label": "Icône",
        "options": [
          { "value": "mail", "label": "Enveloppe" },
          { "value": "clock", "label": "Horloge" },
          { "value": "truck", "label": "Livraison" },
          { "value": "back", "label": "Retour" }
        ], "default": "mail" },
      { "type": "text", "id": "title", "label": "Titre", "default": "Titre" },
      { "type": "textarea", "id": "text", "label": "Texte", "default": "Texte." }
    ]}
  ],
  "presets": [
    { "name": "VOLTAG — Contact", "blocks": [
      { "type": "info", "settings": { "icon": "clock", "title": "Délai de réponse",
        "text": "Sous 24 heures ouvrées, du lundi au vendredi." } },
      { "type": "info", "settings": { "icon": "truck", "title": "Suivi de commande",
        "text": "Le numéro de suivi vous est envoyé par e-mail dès l'expédition." } },
      { "type": "info", "settings": { "icon": "back", "title": "Retours",
        "text": "Vous disposez de 30 jours après réception pour changer d'avis." } }
    ]}
  ]
}
{% endschema %}
