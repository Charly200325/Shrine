{%- comment -%} VOLTAG — Comparatif | sections/voltag-comparatif.liquid {%- endcomment -%}

<style>
#vc-{{ section.id }}{--cy:{{ section.settings.neon }};--ok:{{ section.settings.yes_color }};
  background:{{ section.settings.bg }};color:#fff;padding:64px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif}
#vc-{{ section.id }} *{box-sizing:border-box}
#vc-{{ section.id }} p{margin:0}
#vc-{{ section.id }} .c-in{max-width:900px;margin:0 auto;padding:0 20px;display:flex;flex-direction:column;align-items:center}
#vc-{{ section.id }} .c-eye{margin:0 0 12px;text-align:center;font-size:12px;font-weight:800;letter-spacing:.2em;color:var(--cy);text-shadow:0 0 10px color-mix(in srgb,var(--cy) 50%,transparent)}
#vc-{{ section.id }} h2{margin:0;text-align:center;font-weight:800;letter-spacing:-.02em;line-height:1.08;font-size:clamp(28px,4.4vw,46px);text-wrap:balance}
#vc-{{ section.id }} .c-lz{display:block;width:min(220px,55%);height:3px;margin:16px auto 32px;border-radius:3px;
  background:linear-gradient(90deg,transparent,#FF2D55,#FFD60A,#39FF14,#00A3FF,transparent);
  background-size:200% 100%;animation:vc-flow-{{ section.id }} 3s linear infinite}

#vc-{{ section.id }} .c-card{position:relative;width:100%;border-radius:18px;padding:1.5px;overflow:hidden;isolation:isolate;background:#1c2335}
#vc-{{ section.id }} .c-card::before{content:"";position:absolute;inset:-150%;z-index:-1;opacity:0;
  background:conic-gradient(from 0deg,transparent 0 78%,rgba(255,255,255,.15) 86%,rgba(255,255,255,.7) 94%,#fff 98%,transparent 100%);
  animation:vc-sweep-{{ section.id }} 7s cubic-bezier(.45,0,.25,1) infinite}

#vc-{{ section.id }} .c-tab{background:#0d1424;border-radius:16.5px;display:grid;
  grid-template-columns:minmax(0,1.6fr) repeat(3,minmax(0,1fr));position:relative}
#vc-{{ section.id }} .c-tab>div{padding:14px 12px;border-bottom:1px solid #1a2338;display:flex;align-items:center;
  justify-content:center;text-align:center;font-size:14px;min-width:0}
#vc-{{ section.id }} .c-tab>div.c-f{justify-content:flex-start;text-align:left;color:#c9d1e4;font-weight:600;padding-left:20px}
#vc-{{ section.id }} .c-tab>div.c-hd{border-bottom:1px solid #26304a;font-size:13px;font-weight:800;letter-spacing:.04em;
  color:#8f9ab3;flex-direction:column;gap:6px;padding:18px 10px}
#vc-{{ section.id }} .c-tab>div.c-us{background:color-mix(in srgb,var(--cy) 7%,transparent);position:relative}
#vc-{{ section.id }} .c-tab>div.c-hd.c-us{color:#fff;font-size:15px}
#vc-{{ section.id }} .c-badge{font-size:9.5px;font-weight:800;letter-spacing:.1em;color:#0b1120;background:var(--cy);
  border-radius:999px;padding:3px 8px;white-space:nowrap;box-shadow:0 0 10px color-mix(in srgb,var(--cy) 60%,transparent)}
#vc-{{ section.id }} .c-tab>div:nth-last-child(-n+4){border-bottom:0}
#vc-{{ section.id }} .c-y,#vc-{{ section.id }} .c-n{width:24px;height:24px;flex:none}
#vc-{{ section.id }} .c-y{fill:none;stroke:var(--ok);stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round;
  filter:drop-shadow(0 0 5px color-mix(in srgb,var(--ok) 70%,transparent))}
#vc-{{ section.id }} .c-n{fill:none;stroke:#4a5470;stroke-width:2.2;stroke-linecap:round}

#vc-{{ section.id }} .c-cta{margin-top:28px;display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:16px 28px;border-radius:999px;background:{{ section.settings.cta_bg }};color:#0b1120;font-weight:800;font-size:15px;
  text-decoration:none;box-shadow:0 0 22px color-mix(in srgb,{{ section.settings.cta_bg }} 35%,transparent);transition:transform .2s ease}
#vc-{{ section.id }} .c-cta:hover{transform:translateY(-2px)}
#vc-{{ section.id }} .c-note{margin-top:16px;font-size:12.5px;color:#8f9ab3;text-align:center;line-height:1.6;max-width:620px}

@keyframes vc-flow-{{ section.id }}{to{background-position:200% 0}}
@keyframes vc-sweep-{{ section.id }}{0%{transform:rotate(0);opacity:0}4%{opacity:1}40%{transform:rotate(360deg);opacity:1}46%,100%{transform:rotate(360deg);opacity:0}}

@media (max-width:600px){
  #vc-{{ section.id }}{padding:44px 0}
  #vc-{{ section.id }} .c-in{padding:0 16px}
  #vc-{{ section.id }} .c-tab>div{padding:12px 4px;font-size:12.5px}
  #vc-{{ section.id }} .c-tab>div.c-f{padding-left:12px;font-size:12.5px}
  #vc-{{ section.id }} .c-tab>div.c-hd{font-size:11px;padding:14px 4px;letter-spacing:.02em}
  #vc-{{ section.id }} .c-tab>div.c-hd.c-us{font-size:12.5px}
  #vc-{{ section.id }} .c-badge{font-size:8px;padding:2px 6px}
  #vc-{{ section.id }} .c-y,#vc-{{ section.id }} .c-n{width:20px;height:20px}
  #vc-{{ section.id }} .c-cta{width:100%;font-size:14px}
}
@media (prefers-reduced-motion:reduce){
  #vc-{{ section.id }} .c-lz,#vc-{{ section.id }} .c-card::before{animation:none}
}
</style>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="vc-y-{{ section.id }}" viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5"/></symbol>
  <symbol id="vc-n-{{ section.id }}" viewBox="0 0 24 24"><path d="M7 7l10 10M17 7 7 17"/></symbol>
</svg>

<section id="vc-{{ section.id }}">
  <div class="c-in">
    {%- if section.settings.eyebrow != blank -%}<p class="c-eye">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    <span class="c-lz" aria-hidden="true"></span>

    <div class="c-card">
      <div class="c-tab" role="table">
        <div class="c-hd" role="columnheader"></div>
        <div class="c-hd c-us" role="columnheader">
          {%- if section.settings.badge != blank -%}<span class="c-badge">{{ section.settings.badge }}</span>{%- endif -%}
          {{ section.settings.col_us }}
        </div>
        <div class="c-hd" role="columnheader">{{ section.settings.col_b }}</div>
        <div class="c-hd" role="columnheader">{{ section.settings.col_c }}</div>

        {%- for block in section.blocks -%}
          <div class="c-f" {{ block.shopify_attributes }}>{{ block.settings.label }}</div>
          <div class="c-us">
            {%- if block.settings.us -%}
              <svg class="c-y" role="img" aria-label="Oui"><use href="#vc-y-{{ section.id }}"/></svg>
            {%- else -%}
              <svg class="c-n" role="img" aria-label="Non"><use href="#vc-n-{{ section.id }}"/></svg>
            {%- endif -%}
          </div>
          <div>
            {%- if block.settings.b -%}
              <svg class="c-y" role="img" aria-label="Oui"><use href="#vc-y-{{ section.id }}"/></svg>
            {%- else -%}
              <svg class="c-n" role="img" aria-label="Non"><use href="#vc-n-{{ section.id }}"/></svg>
            {%- endif -%}
          </div>
          <div>
            {%- if block.settings.c -%}
              <svg class="c-y" role="img" aria-label="Oui"><use href="#vc-y-{{ section.id }}"/></svg>
            {%- else -%}
              <svg class="c-n" role="img" aria-label="Non"><use href="#vc-n-{{ section.id }}"/></svg>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.cta_text != blank -%}
      <a class="c-cta" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_text }}</a>
    {%- endif -%}
    {%- if section.settings.note != blank -%}
      <p class="c-note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "VOLTAG — Comparatif",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg", "label": "Fond", "default": "#05060A" },
    { "type": "color", "id": "neon", "label": "Accent", "default": "#00E5FF" },
    { "type": "color", "id": "yes_color", "label": "Couleur des oui", "default": "#39FF14" },
    { "type": "color", "id": "cta_bg", "label": "Couleur du bouton", "default": "#FFD60A" },

    { "type": "header", "content": "Textes" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "POURQUOI LES FAMILLES CHANGENT" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "VOLTAG face aux alternatives" },
    { "type": "text", "id": "badge", "label": "Pastille colonne principale", "default": "NOTRE CHOIX" },
    { "type": "text", "id": "col_us", "label": "Colonne 1", "default": "VOLTAG" },
    { "type": "text", "id": "col_b", "label": "Colonne 2", "default": "Blasters en mousse" },
    { "type": "text", "id": "col_c", "label": "Colonne 3", "default": "Jeux vidéo" },

    { "type": "header", "content": "Bouton" },
    { "type": "text", "id": "cta_text", "label": "Texte du bouton", "default": "Choisir mon pack VOLTAG" },
    { "type": "url", "id": "cta_link", "label": "Lien du bouton" },
    { "type": "textarea", "id": "note", "label": "Mention sous le bouton",
      "info": "Si vous annoncez une date de livraison, assurez-vous de pouvoir la tenir." }
  ],
  "blocks": [
    { "type": "row", "name": "Ligne", "limit": 10, "settings": [
      { "type": "text", "id": "label", "label": "Critère", "default": "Critère" },
      { "type": "checkbox", "id": "us", "label": "VOLTAG", "default": true },
      { "type": "checkbox", "id": "b", "label": "Colonne 2", "default": false },
      { "type": "checkbox", "id": "c", "label": "Colonne 3", "default": false }
    ]}
  ],
  "presets": [
    { "name": "VOLTAG — Comparatif", "blocks": [
      { "type": "row", "settings": { "label": "Éloigne les enfants des écrans", "us": true, "b": true, "c": false } },
      { "type": "row", "settings": { "label": "Aucun projectile à ramasser", "us": true, "b": false, "c": true } },
      { "type": "row", "settings": { "label": "Impacts comptés automatiquement", "us": true, "b": false, "c": true } },
      { "type": "row", "settings": { "label": "Se joue dedans comme dehors", "us": true, "b": true, "c": false } },
      { "type": "row", "settings": { "label": "Toute la famille peut jouer", "us": true, "b": false, "c": false } },
      { "type": "row", "settings": { "label": "Rien qui puisse atteindre le visage", "us": true, "b": false, "c": true } }
    ]}
  ]
}
{% endschema %}
