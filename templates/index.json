}\n\n  .lzt__tag {\n    color: #ffd24a;\n    font-weight: 700;\n  }\n\n  .lzt__t {\n    color: #ffd24a;\n    font-weight: 700;\n    font-variant-numeric: tabular-nums;\n  }\n</style>\n\n<div class=\"lzk\">\n  <span class=\"lzk__pill\">\n    <img src=\"https://cdn.shopify.com/s/files/1/1024/2280/6854/files/instagram-icon_1057-2227.png?v=1793436910\" alt=\"Instagram\" width=\"24\" height=\"24\" loading=\"lazy\">\n    <span>Plus de <b>10M de vues</b> sur Instagram</span>\n  </span>\n</div>\n\n<div class=\"lzt\" id=\"lzt-x\">\n  <span class=\"lzt__pill\">\n    <span class=\"lzt__dot\" aria-hidden=\"true\"></span>\n    <span>\n      <span class=\"lzt__tag\">TENDANCE</span>\n      · L'offre se termine dans\n      <span class=\"lzt__t\" id=\"lzt-timer\">14:15:23</span>\n    </span>\n  </span>\n</div>\n\n<script>\n(function () {\n  var el = document.getElementById('lzt-timer');\n  if (!el) return;\n\n  // Durée du compte à rebours : 14h 15min 23s\n  var DURATION = (14 * 3600 + 15 * 60 + 23) * 1000;\n\n  // Identifiant unique du timer pour ce visiteur\n  var STORAGE_KEY = 'lzt_personal_timer_v1';\n\n  // Date de fin enregistrée lors de la première visite\n  var endTime = localStorage.getItem(STORAGE_KEY);\n\n  if (!endTime || isNaN(Number(endTime))) {\n    endTime = Date.now() + DURATION;\n    localStorage.setItem(STORAGE_KEY, endTime);\n  } else {\n    endTime = Number(endTime);\n  }\n\n  function two(n) {\n    return String(n).padStart(2, '0');\n  }\n\n  function render() {\n    var remaining = endTime - Date.now();\n\n    // Nouveau cycle lorsque le précédent est terminé\n    if (remaining <= 0) {\n      endTime = Date.now() + DURATION;\n      localStorage.setItem(STORAGE_KEY, endTime);\n      remaining = DURATION;\n    }\n\n    var totalSeconds = Math.ceil(remaining / 1000);\n\n    var h = Math.floor(totalSeconds / 3600);\n    var m = Math.floor((totalSeconds % 3600) / 60);\n    var s = totalSeconds % 60;\n\n    el.textContent = two(h) + ':' + two(m) + ':' + two(s);\n  }\n\n  render();\n  setInterval(render, 1000);\n})();\n</script>",
