            "html_code": "<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Lazrtag – Confiance &amp; FAQ</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&amp;display=swap\" rel=\"stylesheet\">\n<style>\n  .lzs-demo { max-width: 560px; margin: 0 auto; }\n\n  /* ================== SECTION ================== */\n  @property --lz-a {\n    syntax: '<angle>';\n    inherits: false;\n    initial-value: 0deg;\n  }\n  @keyframes lz-spin { to { --lz-a: 360deg; } }\n\n  .lzs {\n    --lz-bg: #0f1424;\n    --lz-line: #1d2438;\n    --lz-cyan: #63d2f7;\n    --lz-circle: #1a2038;\n    container-type: inline-size;\n    width: 100%;\n    font-family: 'Inter', system-ui, sans-serif;\n    letter-spacing: 0;\n    color: #fff;\n  }\n  .lzs *, .lzs *::before, .lzs *::after { box-sizing: border-box; }\n  .lzs p, .lzs h3 { margin: 0; }\n\n  /* carte avec bordure lumineuse qui tourne */\n  .lzs__card {\n    position: relative;\n    background: var(--lz-bg);\n    border: 1px solid var(--lz-line);\n    border-radius: clamp(18px, 4cqw, 28px);\n  }\n  .lzs__card::before {\n    content: \"\";\n    position: absolute;\n    inset: -1px;\n    border-radius: inherit;\n    padding: 1.5px;\n    background: conic-gradient(\n      from var(--lz-a),\n      transparent 0 62%,\n      rgba(99, 210, 247, .0) 62%,\n      rgba(99, 210, 247, .55) 82%,\n      #ffffff 93%,\n      rgba(99, 210, 247, .0) 100%\n    );\n    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);\n    -webkit-mask-composite: xor;\n            mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);\n    animation: lz-spin 5s linear infinite;\n    pointer-events: none;\n  }\n  .lzs__acc:nth-of-type(2)::before { animation-delay: -1.7s; }\n  .lzs__acc:nth-of-type(3)::before { animation-delay: -3.4s; }\n\n  /* ---------- Bandeau de confiance ---------- */\n  .lzs__trust {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    margin-bottom: clamp(12px, 4.7cqw, 32px);\n  }\n  .lzs__trust-item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: flex-start;\n    gap: clamp(8px, 2cqw, 14px);\n    padding: clamp(14px, 3.6cqw, 24px) clamp(6px, 1.6cqw, 12px);\n    text-align: center;\n    font-size: clamp(11px, 2.9cqw, 18px);\n    font-weight: 700;\n    line-height: 1.25;\n    text-wrap: balance;\n  }\n  .lzs__trust-item + .lzs__trust-item { border-left: 1px solid var(--lz-line); }\n  .lzs__trust-item svg {\n    width: clamp(22px, 5.2cqw, 34px);\n    height: clamp(22px, 5.2cqw, 34px);\n    fill: none;\n    stroke: var(--lz-cyan);\n    stroke-width: 1.8;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n    filter: drop-shadow(0 0 6px rgba(99, 210, 247, .55));\n  }\n\n  /* ---------- Accordéons ---------- */\n  .lzs__acc { margin-bottom: clamp(10px, 1.9cqw, 16px); }\n  .lzs__acc:last-child { margin-bottom: 0; }\n\n  .lzs__head {\n    all: unset;\n    box-sizing: border-box;\n    display: flex;\n    align-items: center;\n    gap: clamp(12px, 3cqw, 22px);\n    width: 100%;\n    padding: clamp(12px, 3cqw, 22px) clamp(12px, 3.4cqw, 24px);\n    cursor: pointer;\n    position: relative;\n    z-index: 1;\n  }\n  .lzs__head:focus-visible { outline: 2px solid var(--lz-cyan); outline-offset: 2px; border-radius: 20px; }\n\n  .lzs__ico {\n    flex: none;\n    display: grid;\n    place-items: center;\n    width: clamp(38px, 8.9cqw, 60px);\n    height: clamp(38px, 8.9cqw, 60px);\n    border-radius: 50%;\n    background: var(--lz-circle);\n  }\n  .lzs__ico svg {\n    width: 46%;\n    height: 46%;\n    fill: none;\n    stroke: var(--lz-cyan);\n    stroke-width: 1.8;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .lzs__title {\n    flex: 1;\n    font-size: clamp(14px, 3.4cqw, 22px);\n    font-weight: 700;\n    line-height: 1.2;\n    color: #fff;\n  }\n\n  .lzs__plus {\n    flex: none;\n    display: grid;\n    place-items: center;\n    width: clamp(30px, 7.3cqw, 50px);\n    height: clamp(30px, 7.3cqw, 50px);\n    border-radius: 50%;\n    background: var(--lz-circle);\n  }\n  .lzs__plus svg {\n    width: 44%;\n    height: 44%;\n    stroke: var(--lz-cyan);\n    stroke-width: 2.2;\n    stroke-linecap: round;\n    fill: none;\n  }\n  .lzs__plus .v { transform-origin: center; transition: transform .25s ease, opacity .25s ease; }\n  .lzs__head[aria-expanded=\"true\"] .lzs__plus .v { transform: scaleY(0); opacity: 0; }\n\n  .lzs__body {\n    display: grid;\n    grid-template-rows: 0fr;\n    transition: grid-template-rows .3s ease;\n    position: relative;\n    z-index: 1;\n  }\n  .lzs__acc.is-open .lzs__body { grid-template-rows: 1fr; }\n  .lzs__body > div { overflow: hidden; }\n  .lzs__text {\n    padding: 0 clamp(14px, 3.6cqw, 26px) clamp(14px, 3.4cqw, 24px);\n    font-size: clamp(12px, 2.6cqw, 16px);\n    font-weight: 500;\n    line-height: 1.6;\n    color: #aab3c9;\n  }\n  .lzs__text p + p { margin-top: .7em; }\n  .lzs__text b { color: #fff; font-weight: 700; }\n\n  @media (prefers-reduced-motion: reduce) {\n    .lzs__card::before { animation: none; }\n    .lzs__body, .lzs__plus .v { transition: none; }\n  }\n</style>\n\n\n\n<div class=\"lzs-demo\">\n<section class=\"lzs\" id=\"lzs-x\">\n\n  <!-- Bandeau de confiance -->\n  <div class=\"lzs__card lzs__trust\">\n    <div class=\"lzs__trust-item\">\n      <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M1.5 6.5A1.5 1.5 0 0 1 3 5h9.5A1.5 1.5 0 0 1 14 6.5V16H1.5z\"></path><path d=\"M14 9h4.2a1.5 1.5 0 0 1 1.2.6L22 13v3h-8\"></path><circle cx=\"6\" cy=\"17.5\" r=\"1.8\"></circle><circle cx=\"17.5\" cy=\"17.5\" r=\"1.8\"></circle></svg>\n      <span>Livraison suivie</span>\n    </div>\n    <div class=\"lzs__trust-item\">\n      <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5 4 5.5v6c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10v-6z\"></path><path d=\"m8.6 12 2.4 2.4 4.6-4.8\"></path></svg>\n      <span>Retours sous 30 jours</span>\n    </div>\n    <div class=\"lzs__trust-item\">\n      <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"4.5\" y=\"10.5\" width=\"15\" height=\"10.5\" rx=\"2.5\"></rect><path d=\"M8 10.5V7.5a4 4 0 0 1 8 0v3\"></path></svg>\n      <span>Paiement sécurisé</span>\n    </div>\n  </div>\n\n  <!-- 1 -->\n  <div class=\"lzs__card lzs__acc\">\n    <button class=\"lzs__head\" type=\"button\" aria-expanded=\"false\" aria-controls=\"lzs-b1\" id=\"lzs-h1\">\n      <span class=\"lzs__ico\"><svg viewbox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.8 20 7v10l-8 4.2L4 17V7z\"></path><path d=\"M4 7l8 4.2L20 7\"></path><path d=\"M12 11.2v10\"></path></svg></span>\n      <span class=\"lzs__title\">Que contient la boîte ?</span>\n      <span class=\"lzs__plus\"><svg viewbox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path class=\"v\" d=\"M12 5v14\"></path></svg></span>\n    </button>\n    <div class=\"lzs__body\" id=\"lzs-b1\" role=\"region\" aria-labelledby=\"lzs-h1\">\n      <div>\n        <div class=\"lzs__text\">\n          <p><b>Pack Duo X2 :</b> 2 pistolets infrarouges + 2 cibles LED à porter sur la poitrine, parfait pour un 1 contre 1.</p>\n          <p><b>Pack Battle X4 :</b> 4 pistolets infrarouges + 4 cibles LED aux couleurs de 4 équipes, prêt pour de vraies batailles par équipes.</p>\n          <p><b>Pack Squad X8 :</b> 8 pistolets infrarouges + 8 cibles LED, conçu pour les grandes parties en famille.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- 2 -->\n  <div class=\"lzs__card lzs__acc\">\n    <button class=\"lzs__head\" type=\"button\" aria-expanded=\"false\" aria-controls=\"lzs-b2\" id=\"lzs-h2\">\n      <span class=\"lzs__ico\"><svg viewbox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 20.5s-8-4.9-8-11A4.6 4.6 0 0 1 12 6.8 4.6 4.6 0 0 1 20 9.5c0 6.1-8 11-8 11z\"></path></svg></span>\n      <span class=\"lzs__title\">Est-ce sans danger pour les enfants ?</span>\n      <span class=\"lzs__plus\"><svg viewbox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path class=\"v\" d=\"M12 5v14\"></path></svg></span>\n    </button>\n    <div class=\"lzs__body\" id=\"lzs-b2\" role=\"region\" aria-labelledby=\"lzs-h2\">\n      <div>\n        <div class=\"lzs__text\">\n          <p>Oui. Il fonctionne par <b>infrarouge, comme une télécommande de télévision</b> : pas de vrai laser, pas de fléchettes, rien qui puisse blesser ou se perdre. Les sangles réglables conviennent aux enfants dès 6 ans comme aux adultes.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- 3 -->\n  <div class=\"lzs__card lzs__acc\">\n    <button class=\"lzs__head\" type=\"button\" aria-expanded=\"false\" aria-controls=\"lzs-b3\" id=\"lzs-h3\">\n      <span class=\"lzs__ico\"><svg viewbox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M1.5 6.5A1.5 1.5 0 0 1 3 5h9.5A1.5 1.5 0 0 1 14 6.5V16H1.5z\"></path><path d=\"M14 9h4.2a1.5 1.5 0 0 1 1.2.6L22 13v3h-8\"></path><circle cx=\"6\" cy=\"17.5\" r=\"1.8\"></circle><circle cx=\"17.5\" cy=\"17.5\" r=\"1.8\"></circle></svg></span>\n      <span class=\"lzs__title\">Livraison &amp; expédition</span>\n      <span class=\"lzs__plus\"><svg viewbox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path class=\"v\" d=\"M12 5v14\"></path></svg></span>\n    </button>\n    <div class=\"lzs__body\" id=\"lzs-b3\" role=\"region\" aria-labelledby=\"lzs-h3\">\n      <div>\n        <div class=\"lzs__text\">\n          <p><b>Livré en 3 à  7 jours ouvrés, suivi offert</b> sur toutes les commandes. Une idée cadeau parfaite pour Noël !\n\n</p>\n        </div>\n      </div>\n    </div>\n  </div>\n\n</section>\n</div>\n\n<script>\n(function () {\n  var root = document.getElementById('lzs-x');\n  root.querySelectorAll('.lzs__head').forEach(function (btn) {\n    btn.addEventListener('click', function () {\n      var acc = btn.closest('.lzs__acc');\n      var open = !acc.classList.contains('is-open');\n      acc.classList.toggle('is-open', open);\n      btn.setAttribute('aria-expanded', open ? 'true' : 'false');\n    });\n  });\n})();\n</script>",
