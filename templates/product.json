            "html_code": "<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Lazrtag – Barre de stock</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&amp;display=swap\" rel=\"stylesheet\">\n<style>\n  body {\n    margin: 0;\n    padding: 40px 16px;\n    background: #0b0f19;\n    font-family: 'Poppins', system-ui, sans-serif;\n  }\n\n  .lzu {\n    width: 100%;\n    max-width: 540px;\n    margin: 14px auto;\n    padding: 0 4px;\n    box-sizing: border-box;\n    font-family: 'Poppins', system-ui, sans-serif;\n    color: #9aa3b8;\n  }\n  .lzu p { margin: 0; }\n\n  .lzu__top {\n    display: flex;\n    justify-content: space-between;\n    align-items: baseline;\n    gap: 12px;\n    margin-bottom: 8px;\n  }\n  .lzu__label {\n    font-size: clamp(9px, 2.5vw, 12px);\n    font-weight: 600;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n    color: #9aa3b8;\n  }\n  .lzu__pct {\n    font-size: clamp(10px, 3vw, 14px);\n    font-weight: 600;\n    letter-spacing: 0;\n    white-space: nowrap;\n    color: #d3d8ea;\n  }\n  .lzu__pct b { color: #f9d65c; font-weight: 700; }\n\n  .lzu__bar {\n    height: 6px;\n    background: #1a1d27;\n    border-radius: 999px;\n    overflow: hidden;\n  }\n  .lzu__bar i {\n    display: block;\n    height: 100%;\n    width: 0;\n    border-radius: 999px;\n    background: #f9d65c;\n    transition: width 1.2s cubic-bezier(.22, 1, .36, 1);\n  }\n\n  .lzu__note {\n    margin-top: 14px;\n    font-size: clamp(9.5px, 2.7vw, 14px);\n    font-weight: 500;\n    letter-spacing: 0;\n    color: #9aa3b8;\n  }\n  .lzu__note b { color: #fff; font-weight: 700; }\n</style>\n\n\n\n<div class=\"lzu\" id=\"lzu-x\" data-pct=\"89\">\n  <div class=\"lzu__top\">\n    <p class=\"lzu__label\">Offre pré-vente Black Friday</p>\n    <p class=\"lzu__pct\"><b>89 %</b> déjà vendus</p>\n  </div>\n  <div class=\"lzu__bar\"><i style=\"width: 89%;\"></i></div>\n  <p class=\"lzu__note\">Plus que <b>11 %</b> du stock disponible à ce prix</p>\n</div>\n\n<script>\n(function () {\n  var root = document.getElementById('lzu-x');\n  var pct = parseFloat(root.getAttribute('data-pct')) || 0;\n  var bar = root.querySelector('.lzu__bar i');\n  bar.style.width = '0';\n  requestAnimationFrame(function () {\n    requestAnimationFrame(function () { bar.style.width = pct + '%'; });\n  });\n})();\n</script>",
