            "html_code": "<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Lazrtag – Badges</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&amp;display=swap\" rel=\"stylesheet\">\n<style>\n  body {\n    margin: 0;\n    padding: 40px 16px;\n    background: #0b0f19;\n    font-family: 'Poppins', system-ui, sans-serif;\n  }\n\n  .lzk, .lzt {\n    display: flex;\n    justify-content: center;\n    margin: 14px 0;\n  }\n\n  /* Taille du texte : 20px sur ordinateur, réduit automatiquement sur mobile */\n  .lzk__pill, .lzt__pill {\n    font-family: 'Poppins', system-ui, sans-serif;\n    font-size: clamp(11px, 3.3vw, 14px);\n    letter-spacing: 0;\n    white-space: nowrap;\n    max-width: 100%;\n    box-sizing: border-box;\n    line-height: 1;\n  }\n\n  /* ---------- Badge Instagram ---------- */\n  .lzk__pill {\n    display: inline-flex;\n    align-items: center;\n    gap: .6em;\n    padding: .6em 1.2em;\n    background: #1a1d29;\n    border: 1.5px solid rgba(255, 255, 255, .18);\n    border-radius: 999px;\n    color: #fff;\n    font-weight: 700;\n  }\n  .lzk__pill img {\n    width: 1.6em;\n    height: 1.6em;\n    flex: none;\n    object-fit: contain;\n    display: block;\n  }\n  .lzk__pill b { color: #ffd24a; font-weight: 700; }\n\n  /* ---------- Badge TENDANCE + timer ---------- */\n  .lzt__pill {\n    display: inline-flex;\n    align-items: center;\n    gap: .7em;\n    padding: .5em 1.4em .5em .7em;\n    background: #25251f;\n    border: 1.5px solid rgba(255, 210, 74, .4);\n    border-radius: 999px;\n    color: #fff;\n    font-weight: 600;\n  }\n\n  .lzt__dot {\n    position: relative;\n    width: .7em;\n    height: .7em;\n    margin: .45em;\n    border-radius: 50%;\n    background: #ffd24a;\n    flex: none;\n  }\n  .lzt__dot::before {\n    content: \"\";\n    position: absolute;\n    inset: -.45em;\n    border-radius: 50%;\n    background: rgba(255, 210, 74, .15);\n    animation: lzt-pulse 1.8s ease-in-out infinite;\n  }\n  @keyframes lzt-pulse {\n    0%, 100% { transform: scale(1);   opacity: 1; }\n    50%      { transform: scale(1.2); opacity: .5; }\n  }\n\n  .lzt__tag { color: #ffd24a; font-weight: 700; }\n  .lzt__t {\n    color: #ffd24a;\n    font-weight: 700;\n    font-variant-numeric: tabular-nums;\n  }\n</style>\n\n\n\n<div class=\"lzk\">\n  <span class=\"lzk__pill\">\n    <img src=\"https://cdn.shopify.com/s/files/1/1024/2280/6854/files/instagram-icon_1057-2227.png?v=1793436910\" alt=\"Instagram\" width=\"24\" height=\"24\" loading=\"lazy\">\n    <span>Plus de <b>10M de vues</b> sur Instagram</span>\n  </span>\n</div>\n\n<div class=\"lzt\" id=\"lzt-x\">\n  <span class=\"lzt__pill\">\n    <span class=\"lzt__dot\" aria-hidden=\"true\"></span>\n    <span>\n      <span class=\"lzt__tag\">TENDANCE</span>\n      · L'offre se termine dans\n      <span class=\"lzt__t\" id=\"lzt-timer\">14:15:23</span>\n    </span>\n  </span>\n</div>\n\n<script>\n(function () {\n  var el = document.getElementById('lzt-timer');\n  var p = el.textContent.split(':');\n  var total = (+p[0]) * 3600 + (+p[1]) * 60 + (+p[2]);\n  var two = function (n) { return String(n).padStart(2, '0'); };\n\n  function render() {\n    var h = Math.floor(total / 3600),\n        m = Math.floor((total % 3600) / 60),\n        s = total % 60;\n    el.textContent = two(h) + ':' + two(m) + ':' + two(s);\n  }\n\n  setInterval(function () {\n    total = total > 0 ? total - 1 : 14 * 3600 + 15 * 60 + 23;\n    render();\n  }, 1000);\n})();\n</script>",
